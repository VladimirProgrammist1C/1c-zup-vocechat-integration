////////////////////////////////////////////////////////////////////////////////
// Форма настроек интеграции с VoceChat
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

// Обработчик события открытия формы
//
// Параметры:
//  Отказ - Булево - признак отмены открытия формы
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьСостояниеФормы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Обработчик события изменения переключателя использования интеграции
//
// Параметры:
//  Элемент - ЭлементУправления - элемент управления, вызвавший событие
&НаКлиенте
Процедура ВЧ_ИспользоватьИнтеграциюПриИзменении(Элемент)
	
	НовоеЗначение = ВЧ_ИспользоватьИнтеграцию;
	СтароеЗначение = ПолучитьЗначениеКонстантыВЧ_ИспользоватьИнтеграциюНаСервере();
	
	ДанныеОпроса = Новый Структура("НовоеЗначение, СтароеЗначение", НовоеЗначение, СтароеЗначение);
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьОтветНаВопросОбновления", ЭтотОбъект, ДанныеОпроса);
	ПоказатьВопрос(Оповещение, "Изменить настройки интеграции?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

// Обработчик ответа пользователя на вопрос об изменении настроек
//
// Параметры:
//  РезультатВопроса - КодВозвратаДиалога - результат выбора пользователя
//  ДопПараметры - Структура - дополнительные параметры (новое и старое значение)
&НаКлиенте
Процедура ОбработатьОтветНаВопросОбновления(РезультатВопроса, ДопПараметры) Экспорт 
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ВЧ_ИспользоватьИнтеграциюПриИзмененииНаСервере(ДопПараметры.НовоеЗначение);
		ОбновитьСостояниеФормы(ДопПараметры.НовоеЗначение);
		ОбновитьИнтерфейс();
	Иначе
		ВЧ_ИспользоватьИнтеграцию = ДопПараметры.СтароеЗначение;
		ОбновитьСостояниеФормы(ДопПараметры.СтароеЗначение);
		ОбновитьИнтерфейс();
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события изменения флага показывания ключа
//
// Параметры:
//  Элемент - ЭлементУправления - элемент управления, вызвавший событие
&НаКлиенте
Процедура ПоказыватьКлючПриИзменении(Элемент)
	
	Элементы.ВЧ_BotAPIKey.РежимПароля = НЕ ПоказыватьКлюч;
	Записать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииКлиент

// Обновляет состояние формы в зависимости от значения константы
//
// Параметры:
//  ЗначениеКонстанты - Булево - значение константы (Неопределено - чтение из базы)
&НаКлиенте
Процедура ОбновитьСостояниеФормы(ЗначениеКонстанты = Неопределено)
	
	Если ЗначениеКонстанты = Неопределено Тогда
		ВЧ_ИспользоватьИнтеграцию = ПолучитьЗначениеКонстантыВЧ_ИспользоватьИнтеграциюНаСервере();
	Иначе
		ВЧ_ИспользоватьИнтеграцию = ЗначениеКонстанты;
	КонецЕсли;
	
	Элементы.СтатусИнтеграции.Заголовок = ?(ВЧ_ИспользоватьИнтеграцию, "Интеграция ВКЛЮЧЕНА", "Интеграция ВЫКЛЮЧЕНА");
	
	Элементы.ВЧ_URLСервера.Видимость = ВЧ_ИспользоватьИнтеграцию;
	Элементы.ВЧ_ПортСервера.Видимость = ВЧ_ИспользоватьИнтеграцию;
	Элементы.ВЧ_BotAPIKey.Видимость = ВЧ_ИспользоватьИнтеграцию;
	Элементы.ВЧ_IDКанала.Видимость = ВЧ_ИспользоватьИнтеграцию;
	Элементы.ВЧ_ОтветственныйКадровик.Видимость = ВЧ_ИспользоватьИнтеграцию;
	Элементы.ПоказыватьКлюч.Видимость = ВЧ_ИспользоватьИнтеграцию;
	Элементы.ВЧ_МаксимальноеКоличествоПопыток.Видимость = ВЧ_ИспользоватьИнтеграцию;
	Элементы.ВЧ_ТаймаутHTTP.Видимость = ВЧ_ИспользоватьИнтеграцию;
	
	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииСервер

// Получает значение константы использования интеграции с сервера
//
// Возвращаемое значение:
//  Булево - значение константы
&НаСервере
Функция ПолучитьЗначениеКонстантыВЧ_ИспользоватьИнтеграциюНаСервере()
	Возврат Константы.ВЧ_ИспользоватьИнтеграцию.Получить();
КонецФункции

// Записывает новое значение константы использования интеграции
//
// Параметры:
//  Знач Значение - Булево - новое значение константы
&НаСервере
Процедура ВЧ_ИспользоватьИнтеграциюПриИзмененииНаСервере(Знач Значение)
	
	Попытка
		МенеджерКонстанты = Константы.ВЧ_ИспользоватьИнтеграцию.СоздатьМенеджерЗначения();
		МенеджерКонстанты.Значение = Значение;
		МенеджерКонстанты.Записать();
		
		ТекстСообщения = ?(Значение, "✅ Интеграция ВКЛЮЧЕНА", "Интеграция ВЫКЛЮЧЕНА");
		ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
		
	Исключение
		ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка записи константы: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сохранить настройку: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти