&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// При открытии сразу применяем логику видимости
	ОбновитьСостояниеФормы();
	
КонецПроцедуры

// ============================================================================
// 1. ОБРАБОТКА ГЛАВНОГО ПЕРЕКЛЮЧАТЕЛЯ
// ============================================================================

&НаКлиенте
Процедура ВЧ_ИспользоватьИнтеграциюПриИзменении(Элемент)
	
	// Сохраняем новое значение и старое для отката
	НовоеЗначение = ВЧ_ИспользоватьИнтеграцию;
	СтароеЗначение = ПолучитьЗначениеКонстантыВЧ_ИспользоватьИнтеграциюНаСервере();
	
	// Передаем оба значения в обработчик ответа
	ДанныеОпроса = Новый Структура("НовоеЗначение, СтароеЗначение", НовоеЗначение, СтароеЗначение);
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьОтветНаВопросОбновления", ЭтотОбъект, ДанныеОпроса);
	ПоказатьВопрос(Оповещение, "Изменить настройки интеграции?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветНаВопросОбновления(РезультатВопроса, ДопПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		// Записываем новое значение в базу
		ВЧ_ИспользоватьИнтеграциюПриИзмененииНаСервере(ДопПараметры.НовоеЗначение);
		ОбновитьСостояниеФормы();
		ОбновитьИнтерфейс();
		
	Иначе
		
		// Возвращаем старое значение в форму
		ВЧ_ИспользоватьИнтеграцию = ДопПараметры.СтароеЗначение;
		ОбновитьСостояниеФормы();
		
	КонецЕсли;
	
КонецПроцедуры

