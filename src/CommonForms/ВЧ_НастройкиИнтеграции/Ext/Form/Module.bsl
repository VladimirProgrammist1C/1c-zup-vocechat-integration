//###############################################################################
// Форма настроек интеграции с VoceChat
//###############################################################################

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ОбновитьСостояниеФормы();
КонецПроцедуры

&НаКлиенте
Процедура ВЧ_ИспользоватьИнтеграциюПриИзменении(Элемент)
	
	НовоеЗначение = ВЧ_ИспользоватьИнтеграцию;
    СтароеЗначение = ПолучитьЗначениеКонстантыВЧ_ИспользоватьИнтеграциюНаСервере();
    
    ДанныеОпроса = Новый Структура("НовоеЗначение, СтароеЗначение", НовоеЗначение, СтароеЗначение);
    
    Оповещение = Новый ОписаниеОповещения("ОбработатьОтветНаВопросОбновления", ЭтотОбъект, ДанныеОпроса);
    ПоказатьВопрос(Оповещение, "Изменить настройки интеграции?", РежимДиалогаВопрос.ДаНет);
    
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветНаВопросОбновления(РезультатВопроса, ДопПараметры) Экспорт 
    
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        // 1. Сохраняем в базу
        ВЧ_ИспользоватьИнтеграциюПриИзмененииНаСервере(ДопПараметры.НовоеЗначение);
        
        // 2. Обновляем интерфейс, передавая новое значение явно (чтобы не читать кэш)
        ОбновитьСостояниеФормы(ДопПараметры.НовоеЗначение);   
		ОбновитьИнтерфейс();
        
    Иначе
        // 1. Откатываем переключатель  
        ВЧ_ИспользоватьИнтеграцию = ДопПараметры.СтароеЗначение;
        
        // 2. Обновляем интерфейс, возвращая старое значение
        ОбновитьСостояниеФормы(ДопПараметры.СтароеЗначение);
		ОбновитьИнтерфейс();
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьКлючПриИзменении(Элемент)
    
    Если ПоказыватьКлюч Тогда
        Элементы.ВЧ_BotAPIKey.РежимПароля = Ложь;
    Иначе
        Элементы.ВЧ_BotAPIKey.РежимПароля = Истина;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояниеФормы(ЗначениеКонстанты = Неопределено)
    
    // Если значение не передано — читаем из базы (для ПриОткрытии)
    Если ЗначениеКонстанты = Неопределено Тогда
        ВЧ_ИспользоватьИнтеграцию = ПолучитьЗначениеКонстантыВЧ_ИспользоватьИнтеграциюНаСервере();
    Иначе
        // Если передано — используем его (для мгновенного обновления после диалога)
        ВЧ_ИспользоватьИнтеграцию = ЗначениеКонстанты;
    КонецЕсли;
    
    ИнтеграцияВключена = ВЧ_ИспользоватьИнтеграцию;   
	
	// === Статус интеграции (текст в декорации) ===
    Элементы.СтатусИнтеграции.Заголовок = ?(ИнтеграцияВключена, "Интеграция ВКЛЮЧЕНА", "Интеграция ВЫКЛЮЧЕНА");
    
    // === Видимость полей ===
    // Показываем всё, кроме главного переключателя, только если интеграция включена
    Элементы.ВЧ_URLСервера.Видимость = ИнтеграцияВключена;
    Элементы.ВЧ_ПортСервера.Видимость = ИнтеграцияВключена;
    Элементы.ВЧ_BotAPIKey.Видимость = ИнтеграцияВключена;
    Элементы.ВЧ_IDКанала.Видимость = ИнтеграцияВключена;
    Элементы.ВЧ_ОтветственныйКадровик.Видимость = ИнтеграцияВключена;
    Элементы.ПоказыватьКлюч.Видимость = ИнтеграцияВключена;
    Элементы.ВЧ_МаксимальноеКоличествоПопыток.Видимость = ИнтеграцияВключена;
	Элементы.ВЧ_ТаймаутHTTP.Видимость = ИнтеграцияВключена;
    
    ЭтаФорма.ОбновитьОтображениеДанных();
    
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеКонстантыВЧ_ИспользоватьИнтеграциюНаСервере()
    Возврат Константы.ВЧ_ИспользоватьИнтеграцию.Получить();
КонецФункции

&НаСервере
Процедура ВЧ_ИспользоватьИнтеграциюПриИзмененииНаСервере(Значение)
    
    Попытка
        // ✅ ЕДИНСТВЕННЫЙ СПОСОБ ЗАПИСИ (МенеджерЗначения)
        МенеджерКонстанты = Константы.ВЧ_ИспользоватьИнтеграцию.СоздатьМенеджерЗначения();
        МенеджерКонстанты.Значение = Значение;
        МенеджерКонстанты.Записать();
        
        ТекстСообщения = ?(Значение, "✅ Интеграция ВКЛЮЧЕНА", " Интеграция ВЫКЛЮЧЕНА");
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
        
    Исключение
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
            "Ошибка записи константы: " + ОписаниеОшибки());
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сохранить настройку: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры       
