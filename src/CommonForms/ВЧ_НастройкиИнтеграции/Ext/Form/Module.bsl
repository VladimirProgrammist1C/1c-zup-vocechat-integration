// ============================================================================
// 2. ОБРАБОТКА ГАЛКИ "ПОКАЗАТЬ КЛЮЧ"
// ============================================================================

&НаКлиенте
Процедура ПоказыватьКлючПриИзменении(Элемент)
	
	// Если галочка стоит - убираем защиту, иначе - ставим
	Если ПоказыватьКлюч Тогда
		Элементы.ВЧ_BotAPIKey.РежимПароля = Ложь;
	Иначе
		Элементы.ВЧ_BotAPIKey.РежимПароля = Истина;
	КонецЕсли;
	
КонецПроцедуры

// ============================================================================
// 3. ОБЩАЯ ФУНКЦИЯ УПРАВЛЕНИЯ ВИДИМОСТЬЮ/ДОСТУПНОСТЬЮ
// ============================================================================

&НаКлиенте
Процедура ОбновитьСостояниеФормы()
	
	ВЧ_ИспользоватьИнтеграцию = ПолучитьЗначениеКонстантыВЧ_ИспользоватьИнтеграциюНаСервере();
    ИнтеграцияВключена = ВЧ_ИспользоватьИнтеграцию;
	
    // Управляем доступностью (Enabled) полей настроек
    // Если интеграция выключена - поля недоступны (серые)
	ВЧ_ИспользоватьИнтеграцию1 = ИнтеграцияВключена;
    Элементы.ВЧ_URLСервера.Видимость = ИнтеграцияВключена;
    Элементы.ВЧ_ПортСервера.Видимость = ИнтеграцияВключена;
    Элементы.ВЧ_BotAPIKey.Видимость = ИнтеграцияВключена;
    Элементы.ВЧ_IDКанала.Видимость = ИнтеграцияВключена;
    Элементы.ВЧ_ОтветственныйКадровик.Видимость = ИнтеграцияВключена;
	Элементы.ПоказыватьКлюч.Видимость = ИнтеграцияВключена;
	
	ЭтаФорма.ОбновитьОтображениеДанных()
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеКонстантыВЧ_ИспользоватьИнтеграциюНаСервере()
	Возврат Константы.ВЧ_ИспользоватьИнтеграцию.Получить();
КонецФункции

&НаСервере
Процедура ВЧ_ИспользоватьИнтеграциюПриИзмененииНаСервере(Знач Значение)
    
    Попытка
        // Устанавливаем значение
        Константы.ВЧ_ИспользоватьИнтеграцию.Установить(Значение);
        
        // ЗАПИСЫВАЕМ в базу данных
        МенеджерКонстанты = Константы.ВЧ_ИспользоватьИнтеграцию.СоздатьМенеджерЗначения();   
		МенеджерКонстанты.Значение = Значение;
        МенеджерКонстанты.Записать();        
		
		НаборКонстант.ВЧ_ИспользоватьИнтеграцию = Значение; 		
        
        // Показываем сообщение (опционально)
        Если Значение Тогда
            ТекстСообщения = "✅ Интеграция ВКЛЮЧЕНА";
        Иначе
            ТекстСообщения = "️ Интеграция ВЫКЛЮЧЕНА";
        КонецЕсли;
        
        // Логирование
        ЗаписьЖурналаРегистрации(
            "ВЧ_Интеграция",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            ТекстСообщения
        );
        
    Исключение
        // Обработка ошибки записи
        ЗаписьЖурналаРегистрации(
            "ВЧ_Интеграция",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Ошибка записи константы: " + ОписаниеОшибки()
        );
        
        // Возвращаем старое значение в форму
        Сообщить("Не удалось сохранить настройку: " + ОписаниеОшибки(), 
                СтатусСообщения.ОченьВажное);
    КонецПопытки;
    
КонецПроцедуры