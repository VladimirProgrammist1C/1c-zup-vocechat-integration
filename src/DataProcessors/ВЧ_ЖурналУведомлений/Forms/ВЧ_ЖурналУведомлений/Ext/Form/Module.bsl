#Область ОбработчикиСобытийФормы

// Инициализирует форму журнала уведомлений при создании.
// Настраивает видимость кнопок в зависимости от прав пользователя,
// устанавливает период отбора и загружает данные.
//
// Параметры:
//  Отказ - Булево - признак отказа от открытия формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки события
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастроитьДоступностьЭлементовФормы();
	УстановитьПериодПоУмолчанию();
	НастроитьОтборПоДокументу();
	СформироватьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обновляет список записей журнала с учетом текущих отборов.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик
//
&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

// Сбрасывает все отборы к значениям по умолчанию и обновляет список.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик
//
&НаКлиенте
Процедура СброситьОтборы(Команда)
	ПериодОтбора.ДатаНачала = НачалоМесяца(ТекущаяДата());
	ПериодОтбора.ДатаОкончания = КонецДня(ТекущаяДата());
	ОтборСтатус = Неопределено;
	ОтборСотрудник = Неопределено;
	ОтборДокумент = Неопределено;
	СформироватьНаСервере();
КонецПроцедуры

// Открывает документ-основание для выбранной записи журнала.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик
//
&НаКлиенте
Процедура ПерейтиКДокументу(Команда)
	
	ТекущиеДанные = Элементы.СписокЗаписей.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку журнала для перехода к документу.");
		Возврат;
	КонецЕсли;
	
	ДокументСсылка = ТекущиеДанные.ДокументОснование;
	
	Если ДокументСсылка = Неопределено Или ДокументСсылка.Пустая() Тогда
		ПоказатьПредупреждение(, "В выбранной записи не указан документ-основание.");
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ДокументСсылка);
	
КонецПроцедуры

// Ставит в очередь повторную отправку помеченных записей уведомлений.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик
//
&НаКлиенте
Процедура ПовторитьОтправку(Команда)
	
	МассивКлючей = ПолучитьКлючиПомеченныхЗаписей();
	
	Если МассивКлючей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПовторитьОтправкуНаСервере(МассивКлючей);
	ПоказатьОповещениеПользователя("Заявки на повторную отправку поставлены.");
	СформироватьНаСервере();
	
КонецПроцедуры

// Удаляет помеченные записи из истории уведомлений с подтверждением пользователя.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик
//
&НаКлиенте
Процедура УдалитьЗаписи(Команда)
	
	МассивКлючей = ПолучитьКлючиПомеченныхЗаписей();
	
	Если МассивКлючей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПодтверждениеУдаленияЗавершено", ЭтаФорма, МассивКлючей),
		"Удалить выбранные записи из истории?",
		РежимДиалогаВопрос.ДаНет
	);
	
КонецПроцедуры

// Обработчик завершения диалога подтверждения удаления записей.
//
// Параметры:
//  Результат - КодВозвратаДиалога - результат работы диалога
//  ДополнительныеПараметры - Массив - массив ключей помеченных записей
//
&НаКлиенте
Процедура ПодтверждениеУдаленияЗавершено(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьЗаписиНаСервере(ДополнительныеПараметры);
	ПоказатьОповещениеПользователя("Записи удалены.");
	СформироватьНаСервере();
	
КонецПроцедуры

// Устанавливает пометку для всех строк списка записей.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик
//
&НаКлиенте
Процедура СписокЗаписейУстановитьВсеПометки(Команда)
	
	Для Каждого Строка Из СписокЗаписей Цикл
		Строка.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Снимает пометку со всех строк списка записей.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик
//
&НаКлиенте
Процедура СписокЗаписейСнятьВсеПометки(Команда)
	
	Для Каждого Строка Из СписокЗаписей Цикл
		Строка.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедурыИФункции

// Формирует список записей журнала на основании отборов и прав доступа.
//
&НаСервере
Процедура СформироватьНаСервере()   
	
	Запрос = СоздатьЗапросДанных();
	СписокЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

// Настраивает видимость элементов формы в зависимости от прав доступа.
//
&НаСервере
Процедура НастроитьДоступностьЭлементовФормы()
	
	ЭтоАдминистратор = ЭтоАдминистраторИнтеграции();
	Элементы.СписокЗаписейУдалитьЗаписи.Видимость = ЭтоАдминистратор;
	
КонецПроцедуры

// Устанавливает период отбора по умолчанию при первом открытии.
//
&НаСервере
Процедура УстановитьПериодПоУмолчанию()
	
	Если ЗначениеЗаполнено(ПериодОтбора.ДатаНачала) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяДата = ТекущаяДатаСеанса();
	ПериодОтбора.ДатаНачала = НачалоМесяца(ТекущаяДата);
	ПериодОтбора.ДатаОкончания = КонецДня(ТекущаяДата);
	
КонецПроцедуры

// Настраивает отбор по документу, если форма открыта из команды документа.
//
&НаСервере
Процедура НастроитьОтборПоДокументу()
	
	Если НЕ Параметры.Свойство("СсылкаНаДокумент") Или Параметры.СсылкаНаДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаНаДокумент = Параметры.СсылкаНаДокумент;
	
	Если СсылкаНаДокумент.Метаданные().Имя <> "ПриемНаРаботу" Тогда
		Возврат;
	КонецЕсли;
	
	ПериодОтбора.ДатаНачала = НачалоМесяца(СсылкаНаДокумент.Дата);
	ПериодОтбора.ДатаОкончания = КонецДня(ТекущаяДата());
	ОтборДокумент = СсылкаНаДокумент;
	
КонецПроцедуры

// Создает и настраивает запрос для получения данных журнала.
//
// Возвращаемое значение:
//  Запрос - настроенный запрос для получения данных журнала
//
&НаСервере
Функция СоздатьЗапросДанных()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|   ВЧ_ОчередьУведомлений.ИДСообщения КАК ИДСообщения,
	|   ВЧ_ОчередьУведомлений.IDКанала КАК IDКанала,
	|   ВЧ_ОчередьУведомлений.ДатаСоздания КАК ДатаСоздания,
	|   ВЧ_ОчередьУведомлений.Статус КАК Статус,
	|   ВЧ_ОчередьУведомлений.ДокументОснование КАК ДокументОснование,
	|   ВЧ_ОчередьУведомлений.ТекстОшибки КАК ТекстОшибки,
	|   ВЧ_ОчередьУведомлений.ПопыткиОтправки КАК Попытки,
	|   ВЧ_ОчередьУведомлений.Сотрудник КАК Сотрудник
	|ИЗ
	|   РегистрСведений.ВЧ_ОчередьУведомлений КАК ВЧ_ОчередьУведомлений
	|ГДЕ
	|   ВЧ_ОчередьУведомлений.ДатаСоздания МЕЖДУ &ДатаНачала И &ДатаОкончания
	|   И (&ОтборСтатус = ЗНАЧЕНИЕ(Перечисление.ВЧ_СтатусыУведомлений.ПустаяСсылка) 
	|       ИЛИ ВЧ_ОчередьУведомлений.Статус = &ОтборСтатус)
	|   И (&ОтборДокумент = ЗНАЧЕНИЕ(Документ.ПриемНаРаботу.ПустаяСсылка) 
	|       ИЛИ ВЧ_ОчередьУведомлений.ДокументОснование = &ОтборДокумент)
	|   И (&ОтборСотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) 
	|       ИЛИ ВЧ_ОчередьУведомлений.Сотрудник = &ОтборСотрудник)
	|   И (ВЧ_ОчередьУведомлений.ОтветственныйКадровик = &ТекущийПользователь 
	|       ИЛИ &ЭтоАдминистратор)
	|УПОРЯДОЧИТЬ ПО
	|   ДатаСоздания УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаНачала", ПериодОтбора.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодОтбора.ДатаОкончания);
	Запрос.УстановитьПараметр("ОтборСтатус",
		ПолучитьЗначениеОтбора(ОтборСтатус, Перечисления.ВЧ_СтатусыУведомлений.ПустаяСсылка()));
	Запрос.УстановитьПараметр("ОтборДокумент",
		ПолучитьЗначениеОтбора(ОтборДокумент, Документы.ПриемНаРаботу.ПустаяСсылка()));
	Запрос.УстановитьПараметр("ОтборСотрудник",
		ПолучитьЗначениеОтбора(ОтборСотрудник, Справочники.Сотрудники.ПустаяСсылка()));
	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("ЭтоАдминистратор", ЭтоАдминистраторИнтеграции());
	
	Возврат Запрос;
	
КонецФункции

// Серверная процедура для постановки записей в очередь на повторную отправку.
//
// Параметры:
//  МассивКлючей - Массив - массив структур с ключами записей (ИДСообщения, IDКанала)
//
&НаСервере
Процедура ПовторитьОтправкуНаСервере(Знач МассивКлючей)
	ВЧ_ИнтеграцияСервер.ПовторитьОтправку(МассивКлючей);
КонецПроцедуры

// Серверная процедура для удаления записей из истории уведомлений.
//
// Параметры:
//  МассивКлючей - Массив - массив структур с ключами записей (ИДСообщения, IDКанала)
//
&НаСервере
Процедура УдалитьЗаписиНаСервере(Знач МассивКлючей)
	ВЧ_ИнтеграцияСервер.УдалитьЗаписиИстории(МассивКлючей);
КонецПроцедуры

// Проверяет, является ли текущий пользователь администратором интеграции.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь имеет административные права
//
Функция ЭтоАдминистраторИнтеграции()
	
	Возврат РольДоступна("ВЧ_АдминистраторИнтеграции") Или РольДоступна("ПолныеПрава");
	
КонецФункции

// Возвращает значение отбора или пустую ссылку, если значение не заполнено.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение
//  ПустаяСсылка - Произвольный - пустая ссылка для возвращения
//
// Возвращаемое значение:
//  Произвольный - значение отбора или пустая ссылка
//
Функция ПолучитьЗначениеОтбора(Значение, ПустаяСсылка)
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат ПустаяСсылка;
	
КонецФункции

#КонецОбласти

#Область КлиентскиеПроцедурыИФункции

// Возвращает массив ключей помеченных записей для операций.
//
// Возвращаемое значение:
//  Массив - массив структур с ключами записей (ИДСообщения, IDКанала)
//
&НаКлиенте
Функция ПолучитьКлючиПомеченныхЗаписей()
	
	МассивКлючей = Новый Массив;
	
	Для Каждого Строка Из СписокЗаписей Цикл
		Если Строка.Пометка И ЗначениеЗаполнено(Строка.ИДСообщения) Тогда
			Ключ = Новый Структура("ИДСообщения, IDКанала", Строка.ИДСообщения, Строка.IDКанала);
			МассивКлючей.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивКлючей.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбрано ни одной строки.");
	КонецЕсли;
	
	Возврат МассивКлючей;
	
КонецФункции

&НаКлиенте
Процедура СписокЗаписейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Элементы.СписокЗаписейДокументОснование.Гиперссылка Тогда 
		СтандартнаяОбработка = Ложь;

		// 1. Получаем строку, на которую кликнули
	    ТекущаяСтрока = Элементы.СписокЗаписей.ТекущиеДанные;
	    
	    Если ТекущаяСтрока = Неопределено Тогда
	        Возврат;
	    КонецЕсли;
	    
	    // 2. Проверяем, есть ли документ
	    Если ТекущаяСтрока.ДокументОснование.Пустая() Тогда
	        Возврат;
	    КонецЕсли;
	    
	    // 3. Открываем форму документа
		ПоказатьЗначение(, ТекущаяСтрока.ДокументОснование);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти