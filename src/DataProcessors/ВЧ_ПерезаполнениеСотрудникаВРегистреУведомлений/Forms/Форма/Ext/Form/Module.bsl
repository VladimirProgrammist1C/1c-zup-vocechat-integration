#Область ОписаниеРеквизитовФормы

&НаКлиенте
Перем ДлительнаяОперация;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДлительнаяОперация = Неопределено;
	Элементы.Индикатор.МаксимальноеЗначение = 100;
	Элементы.Индикатор.Значение = 0;
	Элементы.Индикатор.ОтображатьПроценты = Истина;
	Элементы.ИнформационнаяНадпись.Заголовок = "";
	
	// Устанавливаем значения по умолчанию
	Если ЭтотОбъект.ПакетныйЛимит = 0 Тогда
		ЭтотОбъект.ПакетныйЛимит = 100;
	КонецЕсли;
	
	Если ЭтотОбъект.ИнтервалЛогирования = 0 Тогда
		ЭтотОбъект.ИнтервалЛогирования = 1;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ЗаполнитьСотрудниковВИстории(Команда)
	
	НачатьЗаполнениеСотрудников();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаВыполнения(Команда)
	
	Если ДлительнаяОперация <> Неопределено Тогда
		ДлительныеОперацииКлиент.ОтменитьВыполнение();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедурыИФункции

&НаСервере
Функция НачатьЗаполнениеНаСервере()
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ПакетныйЛимит", ЭтотОбъект.ПакетныйЛимит);
	ПараметрыПроцедуры.Вставить("ИнтервалЛогирования", ЭтотОбъект.ИнтервалЛогирования);
	ПараметрыПроцедуры.Вставить("КоличествоСтрокДляОтладки", ЭтотОбъект.КоличествоСтрокДляОтладки);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = 
		НСтр("ru = 'Заполнение сотрудников в очереди уведомлений'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ВЧ_ИнтеграцияСервер.ЗаполнитьСотрудниковВИсторииФоновое",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
КонецФункции

#КонецОбласти

#Область КлиентскиеПроцедурыИФункции

&НаКлиенте
Процедура НачатьЗаполнениеСотрудников()
	
	ДлительнаяОперация = НачатьЗаполнениеНаСервере();
	
	Если ДлительнаяОперация <> Неопределено И ДлительнаяОперация.Свойство("ИдентификаторЗадания", Неопределено) Тогда
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
		ПараметрыОжидания.Интервал = 1;
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыполненияЗаполнения", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
		
	Иначе
		
		Если ДлительнаяОперация.Свойство("АдресРезультата") И ЗначениеЗаполнено(ДлительнаяОперация.АдресРезультата) Тогда
			
			ПослеВыполненияЗаполнения(ДлительнаяОперация, Неопределено);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполненияЗаполнения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	Если РезультатВыполнения <> Неопределено Тогда
		
		ТекстСообщения = "Заполнено записей: " + РезультатВыполнения.Записано;
		
		Если РезультатВыполнения.КоличествоОшибок > 0 Тогда
			ТекстСообщения = ТекстСообщения + "; Ошибок при обработке: " + РезультатВыполнения.КоличествоОшибок;
		КонецЕсли;
		
		УдалитьИзВременногоХранилища(Результат.АдресРезультата);
		
		Элементы.ИнформационнаяНадпись.Заголовок = ТекстСообщения;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти