
#Область ОписаниеРеквизитовФормы

// Переменная для хранения информации о длительной операции
&НаКлиенте
Перем ДлительнаяОперация;

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Описание:
//  Обработчик события открытия формы. Инициализирует элементы управления
//  и устанавливает значения по умолчанию.
//
// Параметры:
//  Отказ - Булево - признак отказа от открытия формы
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДлительнаяОперация = Неопределено;
	ИнициализироватьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

// Описание:
//  Команда запуска заполнения сотрудников в истории уведомлений.
//
// Параметры:
//  Команда - КомандаФормы - команда формы
&НаКлиенте
Процедура ЗаполнитьСотрудниковВИстории(Команда)
	
	НачатьЗаполнениеСотрудников();
	
КонецПроцедуры

// Описание:
//  Команда отмены выполнения длительной операции.
//
// Параметры:
//  Команда - КомандаФормы - команда формы
&НаКлиенте
Процедура ОтменаВыполнения(Команда)
	
	ОтменитьДлительнуюОперацию();
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедурыИФункции

// Описание:
//  Запускает фоновое задание для заполнения сотрудников в истории уведомлений.
//
// Возвращаемое значение:
//  Структура - результат запуска длительной операции
&НаСервере
Функция НачатьЗаполнениеНаСервере()
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ПакетныйЛимит", ЭтотОбъект.ПакетныйЛимит);
	ПараметрыПроцедуры.Вставить("ИнтервалЛогирования", ЭтотОбъект.ИнтервалЛогирования);
	ПараметрыПроцедуры.Вставить("КоличествоСтрокДляОтладки", ЭтотОбъект.КоличествоСтрокДляОтладки);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = 
		НСтр("ru = 'Заполнение сотрудников в очереди уведомлений'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ВЧ_ИнтеграцияСервер.ЗаполнитьСотрудниковВИсторииФоновое",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
КонецФункции

// Описание:
//  Проверяет, соответствует ли статус значению "Ошибка" перечисления ВЧ_СтатусыУведомлений.
//
// Параметры:
//  Статус - Строка - проверяемое значение статуса
//
// Возвращаемое значение:
//  Булево - Истина, если статус соответствует значению "Ошибка"
&НаСервереБезКонтекста
Функция СтатусЭтоОшибка(Знач Статус)
	
	Возврат Статус = Перечисления.ВЧ_СтатусыУведомлений.Ошибка;
	
КонецФункции

#КонецОбласти

#Область КлиентскиеПроцедурыИФункции

// Описание:
//  Запускает длительную операцию заполнения сотрудников.
&НаКлиенте
Процедура НачатьЗаполнениеСотрудников()
	
	ДлительнаяОперация = НачатьЗаполнениеНаСервере();
	
	Если ДлительнаяОперация <> Неопределено Тогда
		
		Если ИмеетИдентификаторЗадания(ДлительнаяОперация) Тогда
			ОжидатьЗавершениеОперацииАсинхронно(ДлительнаяОперация);
		ИначеЕсли ИмеетАдресРезультата(ДлительнаяОперация) Тогда
			ОбработатьРезультатОперацииСинхронно(ДлительнаяОперация);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Описание:
//  Обработчик завершения длительной операции заполнения сотрудников.
//
// Параметры:
//  Результат - Структура - результат выполнения длительной операции
//  ДополнительныеПараметры - Произвольный - дополнительные параметры (не используются)
&НаКлиенте
Процедура ПослеВыполненияЗаполнения(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Неопределено;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтатусЭтоОшибка(Результат.Статус) Тогда
		ПоказатьОшибкуВыполнения(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ОбработатьРезультатВыполнения(Результат.АдресРезультата);
	
КонецПроцедуры

// Описание:
//  Проверяет, имеет ли длительная операция идентификатор задания.
//
// Параметры:
//  Операция - Структура - структура длительной операции
//
// Возвращаемое значение:
//  Булево - Истина, если операция имеет идентификатор задания
&НаКлиенте
Функция ИмеетИдентификаторЗадания(Знач Операция)
	
	Возврат Операция.Свойство("ИдентификаторЗадания") 
		И Операция.ИдентификаторЗадания <> Неопределено;
	
КонецФункции

// Описание:
//  Проверяет, имеет ли длительная операция адрес результата.
//
// Параметры:
//  Операция - Структура - структура длительной операции
//
// Возвращаемое значение:
//  Булево - Истина, если операция имеет адрес результата
&НаКлиенте
Функция ИмеетАдресРезультата(Знач Операция)
	
	Возврат Операция.Свойство("АдресРезультата") 
		И ЗначениеЗаполнено(Операция.АдресРезультата);
	
КонецФункции

// Описание:
//  Настраивает и запускает асинхронное ожидание завершения длительной операции.
//
// Параметры:
//  Операция - Структура - структура длительной операции
&НаКлиенте
Процедура ОжидатьЗавершениеОперацииАсинхронно(Знач Операция)
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.Интервал = 1;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыполненияЗаполнения", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

// Описание:
//  Обрабатывает результат операции синхронно (если операция уже завершена).
//
// Параметры:
//  Операция - Структура - структура длительной операции
&НаКлиенте
Процедура ОбработатьРезультатОперацииСинхронно(Знач Операция)
	
	ПослеВыполненияЗаполнения(Операция, Неопределено);
	
КонецПроцедуры

// Описание:
//  Показывает ошибку выполнения длительной операции.
//
// Параметры:
//  ИнформацияОбОшибке - Структура - информация об ошибке
&НаКлиенте
Процедура ПоказатьОшибкуВыполнения(Знач ИнформацияОбОшибке)
	
	СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(ИнформацияОбОшибке);
	
КонецПроцедуры

// Описание:
//  Обрабатывает результат выполнения длительной операции.
//
// Параметры:
//  АдресРезультата - Строка - адрес результата во временном хранилище
&НаКлиенте
Процедура ОбработатьРезультатВыполнения(Знач АдресРезультата)
	
	РезультатВыполнения = ПолучитьРезультатИзХранилища(АдресРезультата);
	
	Если РезультатВыполнения <> Неопределено Тогда
		ПоказатьРезультатВыполнения(РезультатВыполнения);
		УдалитьИзВременногоХранилища(АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

// Описание:
//  Получает результат выполнения из временного хранилища.
//
// Параметры:
//  АдресРезультата - Строка - адрес результата во временном хранилище
//
// Возвращаемое значение:
//  Структура - результат выполнения или Неопределено
&НаКлиенте
Функция ПолучитьРезультатИзХранилища(Знач АдресРезультата)
	
	РезультатВыполнения = Неопределено;
	
	Попытка
		РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресРезультата);
	Исключение
		// Ошибка чтения из временного хранилища ожидаема
	КонецПопытки;
	
	Возврат РезультатВыполнения;
	
КонецФункции

// Описание:
//  Показывает результат выполнения операции пользователю.
//
// Параметры:
//  Результат - Структура - структура с данными о результате выполнения
&НаКлиенте
Процедура ПоказатьРезультатВыполнения(Знач Результат)
	
	ТекстСообщения = СформироватьТекстСообщения(Результат);
	Элементы.ИнформационнаяНадпись.Заголовок = ТекстСообщения;
	
КонецПроцедуры

// Описание:
//  Формирует текст сообщения о результате выполнения операции.
//
// Параметры:
//  Результат - Структура - структура с данными о результате выполнения
//
// Возвращаемое значение:
//  Строка - текст сообщения для пользователя
&НаКлиенте
Функция СформироватьТекстСообщения(Знач Результат)
	
	ТекстСообщения = "Заполнено записей: " + Результат.Записано;
	
	Если Результат.КоличествоОшибок > 0 Тогда
		ТекстСообщения = ТекстСообщения + "; Ошибок при обработке: " + Результат.КоличествоОшибок;
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

// Описание:
//  Инициализирует элементы формы и устанавливает значения по умолчанию.
&НаКлиенте
Процедура ИнициализироватьФорму()
	
	НастроитьИндикаторПрогресса();
	УстановитьЗначенияПоУмолчанию();
	
КонецПроцедуры

// Описание:
//  Настраивает индикатор прогресса.
&НаКлиенте
Процедура НастроитьИндикаторПрогресса()
	
	Элементы.Индикатор.МаксимальноеЗначение = 100;
	Элементы.Индикатор.Значение = 0;
	Элементы.Индикатор.ОтображатьПроценты = Истина;
	Элементы.ИнформационнаяНадпись.Заголовок = "";
	
КонецПроцедуры

// Описание:
//  Устанавливает значения по умолчанию для параметров формы.
&НаКлиенте
Процедура УстановитьЗначенияПоУмолчанию()
	
	УстановитьПакетныйЛимитПоУмолчанию();
	УстановитьИнтервалЛогированияПоУмолчанию();
	
КонецПроцедуры

// Описание:
//  Устанавливает пакетный лимит по умолчанию.
&НаКлиенте
Процедура УстановитьПакетныйЛимитПоУмолчанию()
	
	Если ЭтотОбъект.ПакетныйЛимит = 0 Тогда
		ЭтотОбъект.ПакетныйЛимит = 100;
	КонецЕсли;
	
КонецПроцедуры

// Описание:
//  Устанавливает интервал логирования по умолчанию.
&НаКлиенте
Процедура УстановитьИнтервалЛогированияПоУмолчанию()
	
	Если ЭтотОбъект.ИнтервалЛогирования = 0 Тогда
		ЭтотОбъект.ИнтервалЛогирования = 1;
	КонецЕсли;
	
КонецПроцедуры

// Описание:
//  Отменяет выполнение длительной операции.
&НаКлиенте
Процедура ОтменитьДлительнуюОперацию()
	
	Если ДлительнаяОперация <> Неопределено Тогда
		Попытка
			ДлительныеОперацииКлиент.ОтменитьВыполнение();
		Исключение
			// Ошибка отмены операции ожидаема, возможно операция уже завершена
		КонецПопытки;
		ДлительнаяОперация = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти