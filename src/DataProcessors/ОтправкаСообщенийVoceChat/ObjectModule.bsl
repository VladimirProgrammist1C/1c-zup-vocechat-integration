// ВНЕШНЯЯ ОБРАБОТКА: ВЧ_ТестированиеОтправки
// НАЗНАЧЕНИЕ: Тестирование подключения и отправки уведомлений в VoceChat
////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеКонстант

// Локальные константы модуля
Перем ИмяСобытияЖурналаРегистрации;
Перем ТаймаутПоУмолчаниюСек;
Перем КодСостоянияУспехаHTTP;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет тестовую отправку сообщения в VoceChat
//
// Параметры:
//  Параметры - Структура с полями:
//   * АдресСервера - Строка
//   * ПортСервера - Число
//   * БотAPIKey - Строка
//   * IDКанала - Число
//   * ТекстСообщения - Строка
//
// Возвращаемое значение:
//  Структура с полями:
//   * Успех - Булево
//   * Сообщение - Строка
//   * Детали - Строка
&НаСервере
Функция ВыполнитьТестирование(Знач Параметры) Экспорт
	
	ИнициализироватьКонстанты();
	
	Результат = СоздатьРезультат();
	
	Если Не ВалидироватьПараметры(Параметры, Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ОтправитьСообщение(Параметры);
		ЗаполнитьУспехРезультата(Результат, Параметры);
	Исключение
		ЗаполнитьОшибкуРезультата(Результат, ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Возвращает настройки из констант расширения
//
// Возвращаемое значение:
//  Структура с полями:
//   * ИспользоватьИнтеграцию - Булево
//   * АдресСервера - Строка
//   * ПортСервера - Число
//   * БотAPIKey - Строка
//   * IDКанала - Число
//   * ТаймаутHTTP - Число
&НаСервере
Функция ПолучитьНастройкиИнтеграции() Экспорт
	
	ИнициализироватьКонстанты();
	
	Настройки = СоздатьНастройки();
	
	Попытка
		Настройки.Вставить("ИспользоватьИнтеграцию", Константы.ВЧ_ИспользоватьИнтеграцию.Получить());
		Настройки.Вставить("АдресСервера", Константы.ВЧ_URLСервера.Получить());
		Настройки.Вставить("ПортСервера", Константы.ВЧ_ПортСервера.Получить());
		Настройки.Вставить("БотAPIKey", Константы.ВЧ_BotAPIKey.Получить());
		Настройки.Вставить("IDКанала", Константы.ВЧ_IDКанала.Получить());
		Настройки.Вставить("ТаймаутHTTP", Константы.ВЧ_ТаймаутHTTP.Получить());
	Исключение
		Настройки = СоздатьНастройкиПоУмолчанию();
	КонецПопытки;
	
	Возврат Настройки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инициализирует локальные константы модуля
Процедура ИнициализироватьКонстанты()
	
	Если ИмяСобытияЖурналаРегистрации = Неопределено Тогда
		ИмяСобытияЖурналаРегистрации = "ВЧ_Тестирование";
		ТаймаутПоУмолчаниюСек = 30;
		КодСостоянияУспехаHTTP = 200;
	КонецЕсли;
	
КонецПроцедуры

// Создает структуру результата с пустыми значениями
//
// Возвращаемое значение:
//  Структура с полями: Успех (Ложь), Сообщение (""), Детали ("")
Функция СоздатьРезультат()
	Возврат Новый Структура("Успех, Сообщение, Детали", Ложь, "", "");
КонецФункции

// Создает пустую структуру настроек
//
// Возвращаемое значение:
//  Структура
Функция СоздатьНастройки()
	Возврат Новый Структура;
КонецФункции

// Создает структуру настроек по умолчанию
//
// Возвращаемое значение:
//  Структура с полями:
//   * ИспользоватьИнтеграцию - Ложь
//   * АдресСервера - ""
//   * ПортСервера - 0
//   * БотAPIKey - ""
//   * IDКанала - 0
//   * ТаймаутHTTP - 30
Функция СоздатьНастройкиПоУмолчанию()
	Настройки = СоздатьНастройки();
	Настройки.Вставить("ИспользоватьИнтеграцию", Ложь);
	Настройки.Вставить("АдресСервера", "");
	Настройки.Вставить("ПортСервера", 0);
	Настройки.Вставить("БотAPIKey", "");
	Настройки.Вставить("IDКанала", 0);
	Настройки.Вставить("ТаймаутHTTP", ТаймаутПоУмолчаниюСек);
	Возврат Настройки;
КонецФункции

// Заполняет структуру результата при успешной отправке
//
// Параметры:
//  Результат - Структура результата для заполнения
//  Параметры - Структура с параметрами отправки
Процедура ЗаполнитьУспехРезультата(Результат, Параметры)
	Результат.Успех = Истина;
	Результат.Сообщение = "✅ Сообщение успешно отправлено в канал!";
	Результат.Детали = "Канал: " + Параметры.IDКанала + Символы.ПС + 
		"Время: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'");
КонецПроцедуры

// Заполняет структуру результата при ошибке отправки
//
// Параметры:
//  Результат - Структура результата для заполнения
//  ОписаниеОшибки - Строка с описанием ошибки
Процедура ЗаполнитьОшибкуРезультата(Результат, ОписаниеОшибки)
	Результат.Успех = Ложь;
	Результат.Сообщение = "❌ Ошибка отправки";
	Результат.Детали = ОписаниеОшибки;
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурналаРегистрации,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		"Ошибка отправки: " + Результат.Детали);
КонецПроцедуры

// Проверяет параметры перед отправкой
//
// Параметры:
//  Параметры - Структура с настройками
//  Результат - Структура для заполнения сообщений об ошибках
//
// Возвращаемое значение:
//  Булево - Истина если валидация пройдена
Функция ВалидироватьПараметры(Знач Параметры, Результат)
	
	ИнициализироватьКонстанты();
	
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Результат.Сообщение = "Параметры должны быть структурой";
		Возврат Ложь;
	КонецЕсли;
	
	Если ПустаяСтрока(Параметры.АдресСервера) Тогда
		Результат.Сообщение = "Не указан адрес сервера";
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьПорт(Параметры.ПортСервера, Результат) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПустаяСтрока(Параметры.БотAPIKey) Тогда
		Результат.Сообщение = "Не указан Bot API Key";
		Возврат Ложь;
	КонецЕсли;
	
	Если Число(Параметры.IDКанала) = 0 Тогда
		Результат.Сообщение = "Не указан ID канала";
		Возврат Ложь;
	КонецЕсли;
	
	Если Не Параметры.Свойство("ТекстСообщения") Тогда
		Результат.Сообщение = "Не указан текст сообщения";
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет корректность номера порта
//
// Параметры:
//  Порт - Строка или Число с номером порта
//  Результат - Структура для заполнения сообщений об ошибках
//
// Возвращаемое значение:
//  Булево - Истина если порт корректный
Функция ПроверитьПорт(Знач Порт, Результат)
	
	ПортЧисло = Число(Порт);
	Если ПортЧисло <= 0 Или ПортЧисло > 65535 Тогда
		Результат.Сообщение = "Порт сервера должен быть числом от 1 до 65535";
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Отправляет сообщение через HTTP в VoceChat
//
// Параметры:
//  Параметры - Структура с настройками подключения и сообщением
Процедура ОтправитьСообщение(Знач Параметры)
	
	ИнициализироватьКонстанты();
	
	ТаймаутHTTP = ПолучитьТаймаут(Параметры);
	
	HTTP = СоздатьHTTPСоединение(Параметры.АдресСервера, Параметры.ПортСервера, ТаймаутHTTP);
	Заголовки = СоздатьЗаголовки(Параметры.БотAPIKey);
	URL = СформироватьURL(Параметры.IDКанала);
	
	ЗапросHTTP = СоздатьHTTPЗапрос(URL, Заголовки, Параметры.ТекстСообщения);
	Ответ = HTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
	
	ПроверитьОтвет(Ответ);
	
	ЗаписатьЛогУспеха(Параметры.IDКанала);
	
КонецПроцедуры

// Получает таймаут для HTTP-соединения из параметров или использует дефолт
//
// Параметры:
//  Параметры - Структура с настройками
//
// Возвращаемое значение:
//  Число - таймаут в секундах
Функция ПолучитьТаймаут(Параметры)
	
	ТаймаутHTTP = ТаймаутПоУмолчаниюСек;
	
	Если Параметры.Свойство("ТаймаутHTTP") И Параметры.ТаймаутHTTP > 0 Тогда
		ТаймаутHTTP = Параметры.ТаймаутHTTP;
	Иначе
		ЗаписатьПредупреждениеТаймаут();
	КонецЕсли;
	
	Возврат ТаймаутHTTP;
	
КонецФункции

// Записывает предупреждение о том, что используется дефолтный таймаут
Процедура ЗаписатьПредупреждениеТаймаут()
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурналаРегистрации,
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		"Константа таймаута не заполнена. Используется значение по умолчанию: " + ТаймаутПоУмолчаниюСек + " сек");
КонецПроцедуры

// Создает HTTP-соединение с указанными параметрами
//
// Параметры:
//  АдресСервера - Строка - адрес сервера
//  Порт - Строка или Число - номер порта
//  Таймаут - Число - таймаут соединения в секундах
//
// Возвращаемое значение:
//  HTTPСоединение - созданное соединение
Функция СоздатьHTTPСоединение(АдресСервера, Порт, Таймаут)
	Возврат Новый HTTPСоединение(АдресСервера, Число(Порт), , , , Таймаут);
КонецФункции

// Создает заголовки HTTP-запроса
//
// Параметры:
//  БотAPIKey - Строка - ключ авторизации бота
//
// Возвращаемое значение:
//  Соответствие - заголовки HTTP-запроса
Функция СоздатьЗаголовки(БотAPIKey)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("x-api-key", БотAPIKey);
	Заголовки.Вставить("Content-Type", "text/markdown");
	Возврат Заголовки;
КонецФункции

// Формирует URL для отправки сообщения в канал
//
// Параметры:
//  IDКанала - Строка или Число - идентификатор канала
//
// Возвращаемое значение:
//  Строка - полный URL для API
Функция СформироватьURL(IDКанала)
	IDКаналаСтр = СтрЗаменить(Строка(IDКанала), " ", "");
	Возврат "/api/bot/send_to_group/" + IDКаналаСтр;
КонецФункции

// Создает HTTP-запрос с указанными параметрами
//
// Параметры:
//  URL - Строка - URL запроса
//  Заголовки - Соответствие - заголовки запроса
//  ТекстСообщения - Строка - текст сообщения
//
// Возвращаемое значение:
//  HTTPЗапрос - созданный запрос
Функция СоздатьHTTPЗапрос(URL, Заголовки, ТекстСообщения)
	ЗапросHTTP = Новый HTTPЗапрос(URL, Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТекстСообщения, КодировкаТекста.UTF8);
	Возврат ЗапросHTTP;
КонецФункции

// Проверяет HTTP-ответ и генерирует исключение при ошибке
//
// Параметры:
//  Ответ - HTTPОтвет - ответ сервера
Процедура ПроверитьОтвет(Ответ)
	
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	
	Если Ответ.КодСостояния <> КодСостоянияУспехаHTTP Тогда
		ВызватьИсключение "HTTP " + Ответ.КодСостояния + ": " + ТелоОтвета;
	КонецЕсли;
	
КонецПроцедуры

// Записывает в журнал регистрации сообщение об успешной отправке
//
// Параметры:
//  IDКанала - Строка или Число - идентификатор канала
Процедура ЗаписатьЛогУспеха(IDКанала)
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурналаРегистрации,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Тестовое сообщение отправлено. Канал: " + IDКанала);
КонецПроцедуры

#КонецОбласти