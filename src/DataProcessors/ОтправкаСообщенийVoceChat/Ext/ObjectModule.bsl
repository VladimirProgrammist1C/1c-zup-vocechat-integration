// НАЗНАЧЕНИЕ: Тестирование подключения и отправки уведомлений в VoceChat
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

&НаСервере
Функция ВыполнитьТестирование(Знач Параметры) Экспорт
	// Выполняет тестовую отправку сообщения в VoceChat
	// Параметры: АдресСервера, ПортСервера, БотAPIKey, IDКанала, ТекстСообщения
	// Возвращает: Структура {Успех, Сообщение, Детали}
	
	Результат = Новый Структура("Успех, Сообщение, Детали");
	
	// 1. Валидация параметров
	Если Не ВалидироватьПараметры(Параметры, Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// 2. Отправка сообщения через HTTP
	Попытка
		ОтправитьСообщение(Параметры);
		Результат.Успех = Истина;
		Результат.Сообщение = "✅ Сообщение успешно отправлено в канал!";
		Результат.Детали = "Канал: " + Параметры.IDКанала + Символы.ПС + 
		                   "Время: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'");
		
	Исключение
		Результат.Успех = Ложь;
		Результат.Сообщение = "❌ Ошибка отправки";
		Результат.Детали = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьНастройкиИнтеграции() Экспорт
	// Возвращает настройки из констант расширения
	// Возвращает: Структура {АдресСервера, ПортСервера, БотAPIKey, IDКанала}
	
	Настройки = Новый Структура;
	
	Попытка
		Настройки.Вставить("АдресСервера", Константы.ВЧ_URLСервера.Получить());
		Настройки.Вставить("ПортСервера", Строка(Константы.ВЧ_ПортСервера.Получить()));
		Настройки.Вставить("БотAPIKey", Константы.ВЧ_BotAPIKey.Получить());
		Настройки.Вставить("IDКанала", Константы.ВЧ_IDКанала.Получить());
	Исключение
		// Если константы недоступны (нет прав или расширение не активно)
		Настройки.Вставить("АдресСервера", "");
		Настройки.Вставить("ПортСервера", "");
		Настройки.Вставить("БотAPIKey", "");
		Настройки.Вставить("IDКанала", Неопределено);
	КонецПопытки;
	
	Возврат Настройки;
	
КонецФункции

&НаСервере
Функция ПолучитьТекущуюДату() Экспорт
	// Вспомогательная функция для получения текущей даты сервера
	Возврат ТекущаяДатаСеанса();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВалидироватьПараметры(Знач Параметры, Результат)
	
	Если ПустаяСтрока(Параметры.АдресСервера) Тогда
		Результат.Сообщение = "Не указан адрес сервера";
		Возврат Ложь;
	КонецЕсли;
	
	Если ПустаяСтрока(Параметры.ПортСервера) Тогда
		Результат.Сообщение = "Не указан порт сервера";
		Возврат Ложь;
	КонецЕсли;
	
	Если ПустаяСтрока(Параметры.БотAPIKey) Тогда
		Результат.Сообщение = "Не указан Bot API Key";
		Возврат Ложь;
	КонецЕсли;
	
	Если Параметры.IDКанала = Неопределено Тогда
		Результат.Сообщение = "Не указан ID канала";
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ОтправитьСообщение(Знач Параметры)
	
	// Формирование HTTP-соединения
	HTTP = Новый HTTPСоединение(
		Параметры.АдресСервера, 
		Число(Параметры.ПортСервера),
		, , , 30 // Таймаут 30 секунд
	);
	
	// Заголовки запроса
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("x-api-key", Параметры.БотAPIKey);
	Заголовки.Вставить("Content-Type", "text/plain"); // Без charset!
	
	// Формирование URL
	URL = "/api/bot/send_to_group/" + Строка(Параметры.IDКанала);
	
	// Создание запроса
	ЗапросHTTP = Новый HTTPЗапрос(URL, Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(Параметры.ТекстСообщения, КодировкаТекста.UTF8);
	
	// Отправка запроса
	Ответ = HTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	
	// Проверка ответа
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "HTTP " + Ответ.КодСостояния + ": " + ТелоОтвета;
	КонецЕсли;
	
	// Логирование
	ЗаписьЖурналаРегистрации(
		"ВЧ_Тестирование",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Тестовое сообщение отправлено. Канал: " + Параметры.IDКанала
	);
	
КонецПроцедуры

#КонецОбласти