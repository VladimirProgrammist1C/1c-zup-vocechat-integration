&НаКлиенте
Процедура ПриОткрытии(Отказ)
    
    // Загружаем настройки из констант (через серверный вызов)
    ЗагрузитьНастройкиИзКонстант();
    
    // Устанавливаем значения по умолчанию
    Если Не ЗначениеЗаполнено(АдресСервера) Тогда
        АдресСервера = "localhost";
    КонецЕсли;
    
    Если Не ЗначениеЗаполнено(ПортСервера) Тогда
        ПортСервера = "3001";
    КонецЕсли;
    
    Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
        ТекстСообщения = " Тест из 1С:Предприятия";
	КонецЕсли;        
	
	Если Не ЗначениеЗаполнено(ТаймаутHTTP) Тогда 
		ТаймаутHTTP = 30;
	КонецЕсли;
    
    РезультатТеста = "Готов к тестированию. Нажмите 'Выполнить тест'.";
    
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТест(Команда)
    
    // 1. ВАЛИДАЦИЯ НА КЛИЕНТЕ (с предупреждениями!)
    Если ПустаяСтрока(АдресСервера) Тогда
        ПоказатьПредупреждение(, "Не заполнен адрес сервера");
        Элементы.АдресСервера.УстановитьФокус();
        Возврат;
    КонецЕсли;
    
    Если ПустаяСтрока(ПортСервера) Тогда
        ПоказатьПредупреждение(, "Не заполнен порт сервера");
        Элементы.ПортСервера.УстановитьФокус();
        Возврат;
    КонецЕсли;
    
    Если ПустаяСтрока(БотAPIKey) Тогда
        ПоказатьПредупреждение(, "Не заполнен Bot API Key");
        Элементы.БотAPIKey.УстановитьФокус();
        Возврат;
    КонецЕсли;
    
    // 2. Подготовка параметров
    ПараметрыТеста = Новый Структура;
    ПараметрыТеста.Вставить("АдресСервера", АдресСервера);
    ПараметрыТеста.Вставить("ПортСервера", ПортСервера);
    ПараметрыТеста.Вставить("БотAPIKey", БотAPIKey);
    ПараметрыТеста.Вставить("IDКанала", IDКанала);
    ПараметрыТеста.Вставить("ТекстСообщения", ТекстСообщения);
	
	ВыполнитьТестированиеНаСервере(ПараметрыТеста);
    
КонецПроцедуры

&НаСервере
Процедура ВыполнитьТестированиеНаСервере(ПараметрыТеста)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    // 3. Вызов серверного метода ЧЕРЕЗ ОБЪЕКТ
    Попытка
        Результат = ОбработкаОбъект.ВыполнитьТестирование(ПараметрыТеста);
        
        Если Результат.Успех Тогда
            РезультатТеста = Результат.Сообщение + Символы.ПС + Символы.ПС + Результат.Детали;
            Сообщить(Результат.Сообщение, СтатусСообщения.Информация);
        Иначе
            РезультатТеста = Результат.Сообщение + Символы.ПС + Символы.ПС + Результат.Детали;
            Сообщить(Результат.Сообщение, СтатусСообщения.Важное);
        КонецЕсли;
        
    Исключение
        РезультатТеста = "❌ Ошибка: " + Символы.ПС + ОписаниеОшибки();
        Сообщить("Ошибка выполнения: " + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
    КонецПопытки;

КонецПроцедуры


&НаСервере
Процедура ЗагрузитьНастройкиИзКонстант()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Попытка
        Настройки = ОбработкаОбъект.ПолучитьНастройкиИнтеграции();
        
        Если Не ПустаяСтрока(Настройки.АдресСервера) Тогда
            АдресСервера = Настройки.АдресСервера;
        КонецЕсли;
        
        Если Не ПустаяСтрока(Настройки.ПортСервера) Тогда
            ПортСервера = Настройки.ПортСервера;
        КонецЕсли;
        
        Если Не ПустаяСтрока(Настройки.БотAPIKey) Тогда
            БотAPIKey = Настройки.БотAPIKey;
        КонецЕсли;
        
        Если Настройки.IDКанала <> Неопределено Тогда
            IDКанала = Настройки.IDКанала;
        КонецЕсли;
        
    Исключение
        // Если константы недоступны — оставляем пустыми
    КонецПопытки;
    
КонецПроцедуры
