////////////////////////////////////////////////////////////////////////////////
// ФОРМА: Форма
// ОБРАБОТКА: ОтправкаСообщенийVoceChat
// НАЗНАЧЕНИЕ: Тестирование отправки сообщений в VoceChat
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

// Обработчик события открытия формы
//
// Параметры:
//  Отказ - Булево - признак отмены открытия формы
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗагрузитьНастройкиИзКонстант();
	УстановитьЗначенияПоУмолчанию();
	
	РезультатТеста = "Готов к тестированию. Нажмите 'Выполнить тест'.";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды выполнения теста
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик
&НаКлиенте
Процедура ВыполнитьТест(Команда)
	
	Если Не ПроверитьДанныеФормы() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыТеста = ПодготовитьПараметрыТеста();
	ВыполнитьТестированиеНаСервере(ПараметрыТеста);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииКлиент

// Устанавливает значения по умолчанию для пустых полей
Процедура УстановитьЗначенияПоУмолчанию()
	
	Если Не ЗначениеЗаполнено(АдресСервера) Тогда
		АдресСервера = "localhost";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПортСервера) Тогда
		ПортСервера = "3001";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		ТекстСообщения = "Тест из 1С:Предприятия";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТаймаутHTTP) Тогда
		ТаймаутHTTP = 30;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет корректность заполнения данных формы
//
// Возвращаемое значение:
//  Булево - Истина если данные корректны
&НаКлиенте
Функция ПроверитьДанныеФормы()
	
	Если Не ПроверитьАдресСервера() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьПортСервера() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьБотAPIKey() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьIDКанала() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьТекстСообщения() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет заполненность адреса сервера
//
// Возвращаемое значение:
//  Булево - Истина если адрес заполнен
&НаКлиенте
Функция ПроверитьАдресСервера()
	
	Если ПустаяСтрока(АдресСервера) Тогда
		ПоказатьПредупреждение(Ложь, "Не заполнен адрес сервера");
		Элементы.АдресСервера.ТекущийЭлемент = Истина;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет корректность порта сервера
//
// Возвращаемое значение:
//  Булево - Истина если порт корректен
&НаКлиенте
Функция ПроверитьПортСервера()
	
	Если ПустаяСтрока(ПортСервера) Тогда
		ПоказатьПредупреждение(Ложь, "Не заполнен порт сервера");
		Элементы.ПортСервера.ТекущийЭлемент = Истина;
		Возврат Ложь;
	КонецЕсли;
	
	ПортЧисло = Число(ПортСервера);
	Если ПортЧисло <= 0 Или ПортЧисло > 65535 Тогда
		ПоказатьПредупреждение(Ложь, "Порт сервера должен быть числом от 1 до 65535");
		Элементы.ПортСервера.ТекущийЭлемент = Истина;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет заполненность Bot API Key
//
// Возвращаемое значение:
//  Булево - Истина если ключ заполнен
&НаКлиенте
Функция ПроверитьБотAPIKey()
	
	Если ПустаяСтрока(БотAPIKey) Тогда
		ПоказатьПредупреждение(Ложь, "Не заполнен Bot API Key");
		Элементы.БотAPIKey.ТекущийЭлемент = Истина;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет заполненность ID канала
//
// Возвращаемое значение:
//  Булево - Истина если ID канала заполнен
&НаКлиенте
Функция ПроверитьIDКанала()
	
	Если Не ЗначениеЗаполнено(IDКанала) Или Число(IDКанала) = 0 Тогда
		ПоказатьПредупреждение(Ложь, "Не указан ID канала");
		Элементы.IDКанала.ТекущийЭлемент = Истина;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет заполненность текста сообщения
//
// Возвращаемое значение:
//  Булево - Истина если текст сообщения заполнен
&НаКлиенте
Функция ПроверитьТекстСообщения()
	
	Если ПустаяСтрока(ТекстСообщения) Тогда
		ПоказатьПредупреждение(Ложь, "Не заполнен текст сообщения");
		Элементы.ТекстСообщения.ТекущийЭлемент = Истина;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Подготавливает структуру параметров для тестирования
//
// Возвращаемое значение:
//  Структура - параметры для передачи на сервер
&НаКлиенте
Функция ПодготовитьПараметрыТеста()
	
	ПараметрыТеста = Новый Структура; // Было: Параметры
	ПараметрыТеста.Вставить("АдресСервера", АдресСервера);
	ПараметрыТеста.Вставить("ПортСервера", Число(ПортСервера));
	ПараметрыТеста.Вставить("БотAPIKey", БотAPIKey);
	ПараметрыТеста.Вставить("IDКанала", Число(IDКанала));
	ПараметрыТеста.Вставить("ТекстСообщения", ТекстСообщения);
	
	Если ЗначениеЗаполнено(ТаймаутHTTP) Тогда
		ПараметрыТеста.Вставить("ТаймаутHTTP", Число(ТаймаутHTTP));
	КонецЕсли;
	
	Возврат ПараметрыТеста; // Было: Параметры
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииСервер

// Выполняет тестирование отправки сообщения на сервере
//
// Параметры:
//  ПараметрыТеста - Структура - параметры тестирования
&НаСервере
Процедура ВыполнитьТестированиеНаСервере(Знач ПараметрыТеста)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Попытка
		Результат = ОбработкаОбъект.ВыполнитьТестирование(ПараметрыТеста);
		ОтобразитьРезультатТеста(Результат);
	Исключение
		ОтобразитьОшибкуТестирования(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// Отображает результат тестирования в форме
//
// Параметры:
//  Результат - Структура - результат выполнения теста
&НаСервере
Процедура ОтобразитьРезультатТеста(Знач Результат)
	
	РезультатТеста = Результат.Сообщение + Символы.ПС + Символы.ПС + Результат.Детали;
	
	УровеньСообщения = ?(Результат.Успех, СтатусСообщения.Информация, СтатусСообщения.Важное);
	Сообщить(Результат.Сообщение, УровеньСообщения);
	
КонецПроцедуры

// Отображает ошибку тестирования в форме
//
// Параметры:
//  ОписаниеОшибки - Строка - описание ошибки
&НаСервере
Процедура ОтобразитьОшибкуТестирования(Знач ОписаниеОшибки)
	
	РезультатТеста = "Ошибка: " + Символы.ПС + ОписаниеОшибки;
	Сообщить("Ошибка выполнения: " + ОписаниеОшибки, СтатусСообщения.ОченьВажное);
	
КонецПроцедуры

// Загружает настройки интеграции из констант
&НаСервере
Процедура ЗагрузитьНастройкиИзКонстант()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Попытка
		Настройки = ОбработкаОбъект.ПолучитьНастройкиИнтеграции();
		ПрименитьНастройки(Настройки);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Применяет загруженные настройки к реквизитам формы
//
// Параметры:
//  Настройки - Структура - настройки из констант
&НаСервере
Процедура ПрименитьНастройки(Знач Настройки)
	
	Если Не ПустаяСтрока(Настройки.АдресСервера) Тогда
		АдресСервера = Настройки.АдресСервера;
	КонецЕсли;
	
	Если Настройки.ПортСервера > 0 Тогда
		ПортСервера = Строка(Настройки.ПортСервера);
	КонецЕсли;
	
	Если Не ПустаяСтрока(Настройки.БотAPIKey) Тогда
		БотAPIKey = Настройки.БотAPIKey;
	КонецЕсли;
	
	Если Настройки.IDКанала > 0 Тогда
		IDКанала = Настройки.IDКанала;
	КонецЕсли;
	
	Если Настройки.ТаймаутHTTP > 0 Тогда
		ТаймаутHTTP = Настройки.ТаймаутHTTP;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти