
#Область ОбработчикиСобытийФормы

// Описание:
//  Обработчик события создания формы на сервере. Извлекает текст сообщения из хранилища
//  значений для отображения на форме.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    ЗаполнитьТекстСообщения();
    
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет реквизит формы текстом сообщения из хранилища значений
&НаСервере
Процедура ЗаполнитьТекстСообщения()
    
    Если Запись.ТекстСообщения <> Неопределено Тогда
        Попытка
            ТекстСообщенияДляОтображения = ВЧ_ИнтеграцияСервер.ПолучитьТекстИзХранилищаСервер(
                Запись.ТекстСообщения);
        Исключение
            // Ошибка при извлечении текста из хранилища значений.
            // Возможные причины: повреждение данных, несовместимость формата.
            // В данном случае оставляем поле пустым для обеспечения работоспособности формы.
        КонецПопытки;
    КонецЕсли;
    
КонецПроцедуры

#КонецОбласти