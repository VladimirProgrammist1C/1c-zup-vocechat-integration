//###############################################################################
// Интеграция с VoceChat (Сервер)
//###############################################################################

#Область ПрограммныйИнтерфейс

/// <summary>
/// Отправляет сообщение в указанный канал VoceChat через Bot API.
/// Используется регламентным заданием для обработки очереди.
/// </summary>
/// <param name="СсылкаНаСотрудника">Ссылка на документ или справочник для логирования.</param>
/// <param name="ТекстСообщения">Текст сообщения в формате Markdown.</param>
/// <returns>Структура { Успех: Булево, ТекстОшибки: Строка }</returns>
&НаСервере
Функция ОтправитьУведомление(СсылкаНаСотрудника, ТекстСообщения) Экспорт 
	
	// 1. Быстрая проверка: включена ли интеграция
	Если Не Константы.ВЧ_ИспользоватьИнтеграцию.Получить() Тогда
		Возврат Новый Структура("Успех, ТекстОшибки", Истина, "Интеграция отключена");
	КонецЕсли;
	
	// 2. Чтение настроек
	Настройки = ПолучитьНастройки();
	
	// Валидация ключа (чтобы не делать лишний запрос)
	Если ПустаяСтрока(Настройки.BotAPIKey) Тогда
		Возврат Новый Структура("Успех, ТекстОшибки", Ложь, "Не указан BotAPIKey в константах");
	КонецЕсли;
	
	// 3. Формирование URL и заголовков
	URLСервера = СтрШаблон("http://%1:%2", Настройки.URL, Настройки.Порт);
	URI = СтрШаблон("/api/bot/send_to_group/%1", Настройки.GIDКанала);
	
	HTTP = Новый HTTPСоединение(Настройки.URL, Настройки.Порт);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("x-api-key", Настройки.BotAPIKey);
	// TS требует text/plain, но charset=utf-8 добавим для надежности кодировки кириллицы
	Заголовки.Вставить("Content-Type", "text/plain"); 
	
	ЗапросHTTP = Новый HTTPЗапрос(URI, Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТекстСообщения, КодировкаТекста.UTF8);
	
	// 4. Отправка запроса
	Попытка
		
		Ответ = HTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния = 200 Тогда
			ЗаписьЖурналаРегистрации("ВЧ_Интеграция", , , СсылкаНаСотрудника, 
				"Уведомление успешно отправлено в канал " + Настройки.GIDКанала);
			Возврат Новый Структура("Успех, ТекстОшибки", Истина, "");
		Иначе
			ТекстОшибки = СтрШаблон("HTTP %1: %2", Ответ.КодСостояния, ТелоОтвета);
			ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , СсылкаНаСотрудника, ТекстОшибки);
			Возврат Новый Структура("Успех, ТекстОшибки", Ложь, ТекстОшибки);
		КонецЕсли;
		
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , СсылкаНаСотрудника, ТекстОшибки);
		Возврат Новый Структура("Успех, ТекстОшибки", Ложь, ТекстОшибки);
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

/// <summary>
/// Вспомогательная функция для получения настроек из констант.
/// </summary>
&НаСервере
Функция ПолучитьНастройки()
	
	Возврат Новый Структура(
		"URL, Порт, BotAPIKey, GIDКанала",
		Константы.ВЧ_URLСервера.Получить(),
		Константы.ВЧ_ПортСервера.Получить(),
		Константы.ВЧ_BotAPIKey.Получить(),
		Константы.ВЧ_IDКанала.Получить()
	);
	
КонецФункции

#КонецОбласти