//###############################################################################
// Интеграция с VoceChat (Сервер)
//###############################################################################

#Область ПрограммныйИнтерфейс

// Описание:
// Отправляет сообщение в указанный канал VoceChat через Bot API.
// Используется регламентным заданием для обработки очереди.
//
// Параметры:
//  СсылкаНаСотрудника - Ссылка на документ или справочник для логирования
//  ТекстСообщения - Текст сообщения в формате Markdown
//
// Возвращаемое значение:
//  Структура - Структура { Успех: Булево, ТекстОшибки: Строка }
//
&НаСервере
Функция ОтправитьУведомление(СсылкаНаСотрудника, ТекстСообщения) Экспорт 
	
	// Быстрая проверка: включена ли интеграция
	Если Не Константы.ВЧ_ИспользоватьИнтеграцию.Получить() Тогда
		Возврат СоздатьРезультатОтправки(Истина, "Интеграция отключена");
	КонецЕсли;
	
	// Чтение настроек
	Настройки = ПолучитьНастройки();
	
	// Валидация ключа (чтобы не делать лишний запрос)
	Если ПустаяСтрока(Настройки.BotAPIKey) Тогда
		Возврат СоздатьРезультатОтправки(Ложь, "Не указан BotAPIKey в константах");
	КонецЕсли;
	
	// Формирование URI
	URI = СтрШаблон("/api/bot/send_to_group/%1", Настройки.GIDКанала);
	
	// Создание HTTP-соединения с указанием таймаута
	HTTP = Новый HTTPСоединение(
		Настройки.URL, 
		Настройки.Порт, 
		, 
		, 
		, 
		30); // Таймаут 30 секунд
	
	// Формирование заголовков
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("x-api-key", Настройки.BotAPIKey);
	Заголовки.Вставить("Content-Type", "text/plain");
	
	// Создание HTTP-запроса
	ЗапросHTTP = Новый HTTPЗапрос(URI, Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТекстСообщения, КодировкаТекста.UTF8);
	
	// Отправка запроса
	Попытка
		Ответ = HTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		
		Если Ответ.КодСостояния = 200 Тогда
			ЗаписьЖурналаРегистрации(
				"ВЧ_Интеграция", 
				УровеньЖурналаРегистрации.Информация, 
				, 
				СсылкаНаСотрудника, 
				"Уведомление успешно отправлено в канал " + Настройки.GIDКанала);
			Возврат СоздатьРезультатОтправки(Истина, "");
		Иначе
			ТекстОшибки = СтрШаблон("HTTP %1: %2", Ответ.КодСостояния, ТелоОтвета);
			ЗаписьЖурналаРегистрации(
				"ВЧ_Интеграция", 
				УровеньЖурналаРегистрации.Ошибка, 
				, 
				СсылкаНаСотрудника, 
				ТекстОшибки);
			Возврат СоздатьРезультатОтправки(Ложь, ТекстОшибки);
		КонецЕсли;
		
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(
			"ВЧ_Интеграция", 
			УровеньЖурналаРегистрации.Ошибка, 
			, 
			СсылкаНаСотрудника, 
			ТекстОшибки);
		Возврат СоздатьРезультатОтправки(Ложь, ТекстОшибки);
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание:
// Вспомогательная функция для получения настроек из констант.
//
// Возвращаемое значение:
//  Структура - Структура с настройками интеграции: URL, Порт, BotAPIKey, GIDКанала
//
&НаСервере
Функция ПолучитьНастройки()
	
	Возврат Новый Структура(
		"URL, Порт, BotAPIKey, GIDКанала",
		Константы.ВЧ_URLСервера.Получить(),
		Константы.ВЧ_ПортСервера.Получить(),
		Константы.ВЧ_BotAPIKey.Получить(),
		Константы.ВЧ_IDКанала.Получить()
	);
	
КонецФункции

// Описание:
// Создает структуру результата отправки уведомления.
//
// Параметры:
//  Успех - Признак успешной отправки
//  ТекстОшибки - Текст ошибки при неуспешной отправке
//
// Возвращаемое значение:
//  Структура - Структура с полями Успех и ТекстОшибки
//
&НаСервере
Функция СоздатьРезультатОтправки(Знач Успех, Знач ТекстОшибки = "")
	
	Возврат Новый Структура("Успех, ТекстОшибки", Успех, ТекстОшибки);
	
КонецФункции

&НаСервере
Функция ПолучитьТекстИзХранилищаСервер(Хранилище) Экспорт
    Если Хранилище = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Попытка
        Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
            Возврат Хранилище.Получить();
        Иначе
            Возврат "";
        КонецЕсли;
    Исключение
        Возврат "[Ошибка чтения]";
    КонецПопытки;
КонецФункции

#КонецОбласти