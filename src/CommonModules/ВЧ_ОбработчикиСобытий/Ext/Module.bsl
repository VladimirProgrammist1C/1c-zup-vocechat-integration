&НаСервере
Функция СформироватьТекстУведомления(Знач Данные, Знач ФИОКадровика)
	
	ТекстШаблона = 
		" *Новая задача!*
		|═══════════════════════
		|Принят новый сотрудник.
		|
		| *ФИО:* %1
		| *Должность:* %2
		| *Подразделение:* %3
		| *Контакт с новым сотрудником (тел.):* %4
		|
		|═══════════════════════
		| *Задача:* Необходимо создать корпоративную электронную почту.
		|
		| *Ответственный кадровик:* %5
		|⏰ *Дата время:* %6
		|═══════════════════════
		|_Уведомление из 1С:ЗУП 3.1_";
	
	Возврат СтрШаблон(
		ТекстШаблона,
		?(ПустаяСтрока(Данные.ФИО), "Не определено", Данные.ФИО),
		?(ПустаяСтрока(Данные.Должность), "Не указана", Данные.Должность),
		?(ПустаяСтрока(Данные.Подразделение), "Не указано", Данные.Подразделение),
		?(ПустаяСтрока(Данные.Телефон), "Не указан", Данные.Телефон),
		?(ПустаяСтрока(ФИОКадровика), "Не определён", ФИОКадровика),
		Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'")
	);
	
КонецФункции

&НаСервере
Процедура ВЧ_ПриПриемеНаРаботуПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
    
    // === 1. ПРОВЕРКА: Только ПЕРВОЕ проведение ===
    Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
        Возврат;
    КонецЕсли;
    
    Если Источник.Проведен Тогда
        Возврат;
    КонецЕсли;
    
    // === 2. Проверяем интеграцию ===
    Если Не Константы.ВЧ_ИспользоватьИнтеграцию.Получить() Тогда
        Возврат;
    КонецЕсли;
    
    // === 3. Получаем ссылку на сотрудника ===
    СсылкаНаСотрудника = Источник.Сотрудник;
    Если СсылкаНаСотрудника = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // === 4. === ПОЛУЧАЕМ ДАННЫЕ ЧЕРЕЗ ФУНКЦИЮ (БСП) ===
    ДанныеСотрудника = ПолучитьДанныеСотрудника(СсылкаНаСотрудника, Источник);
    
    Если ДанныеСотрудника = Неопределено Тогда
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
            "Не удалось получить данные сотрудника");
        Возврат;
    КонецЕсли;
	
    // === НОВЫЙ БЛОК: ПОЛУЧАЕМ ОТВЕТСТВЕННОГО (АВТОРА ДОКУМЕНТА) ===
    ОтветственныйКадровик = "Не определён";
    
    // В 1С стандартное поле "Ответственный" заполняется автоматически при создании
    Если Источник.Ответственный <> Неопределено Тогда
        Попытка
            // Берем Наименование пользователя (например: "Иванов И.И.")
            ОтветственныйКадровик = Источник.Ответственный.Наименование;
        Исключение
            // На случай, если пользователь удален или битая ссылка
            ОтветственныйКадровик = "Неизвестный";
        КонецПопытки;
	КонецЕсли;     
	
	ДанныеСотрудника.Вставить("ФИОКадровика", ОтветственныйКадровик);
    // ==================================================================	
	
    // === 5. Записываем в очередь ===
    Попытка
        НаборЗаписей = РегистрыСведений.ВЧ_ОчередьУведомлений.СоздатьНаборЗаписей();
        НоваяЗапись = НаборЗаписей.Добавить();
        
        НоваяЗапись.Сотрудник = СсылкаНаСотрудника;
		//НоваяЗапись.ТипСобытия = Перечисления.ВЧ_ТипыСобытий.НовыйСотрудник;
        НоваяЗапись.Статус = Перечисления.ВЧ_СтатусыУведомлений.Ожидает;
        НоваяЗапись.ДатаСоздания = ТекущаяДатаСеанса();
        
        // Сохраняем ВСЕ данные из функции
        НоваяЗапись.Параметры = Новый ХранилищеЗначения(ДанныеСотрудника);
        
        НаборЗаписей.Записать();
        
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", , , СсылкаНаСотрудника, 
            "Задача поставлена в очередь. Сотрудник: " + ДанныеСотрудника.ФИО);
            
    Исключение
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
            "Ошибка записи в регистр: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

// ============================================================================
// === ФУНКЦИЯ ПОЛУЧЕНИЯ ДАННЫХ СОТРУДНИКА (ИСПОЛЬЗУЕТ БСП) ===
// ============================================================================
&НаСервере
Функция ПолучитьДанныеСотрудника(СсылкаНаСотрудника, ИсточникДокумент = Неопределено)
    
    // Инициализируем структуру данных
    Данные = Новый Структура;
    Данные.Вставить("ФИО", "");
    Данные.Вставить("Должность", "");
    Данные.Вставить("Подразделение", "");
    Данные.Вставить("Телефон", "");
    Данные.Вставить("Email", "");
    
    // === 1. ПОЛУЧАЕМ КАДРОВЫЕ ДАННЫЕ через БСП ===
    Попытка
        ТЗКадровые = КадровыйУчет.КадровыеДанныеСотрудников(
            Истина,                                      // Только разрешенные
            СсылкаНаСотрудника,                          // Ссылка на сотрудника
            "ФИОПолные, Должность, Подразделение",      // Какие поля
            ТекущаяДатаСеанса()                          // На дату
        );
        
        Если ТЗКадровые.Количество() > 0 Тогда
            СтрокаДанных = ТЗКадровые[0];
            Данные.ФИО = СтрокаДанных.ФИОПолные;
            
            Если СтрокаДанных.Должность <> Неопределено Тогда
                Данные.Должность = ?(ИсточникДокумент.Должность = Неопределено, "", ИсточникДокумент.Должность.Наименование);
            КонецЕсли;
            
            Если СтрокаДанных.Подразделение <> Неопределено Тогда
                Данные.Подразделение = ?(ИсточникДокумент.Подразделение = Неопределено, "", ИсточникДокумент.Подразделение.Наименование);
            КонецЕсли;
        КонецЕсли;
        
    Исключение
        // Если БСП не сработала — пробуем из документа
    КонецПопытки;
    
    // === 2. FALLBACK: Если кадровые данные пустые — берем из документа ===
    Если ПустаяСтрока(Данные.ФИО) И ИсточникДокумент <> Неопределено Тогда
        Попытка
            ОбъектСотрудника = СсылкаНаСотрудника.ПолучитьОбъект();
            Если ОбъектСотрудника <> Неопределено Тогда
                Данные.ФИО = ОбъектСотрудника.ФизическоеЛицо.Наименование;
            КонецЕсли;
        Исключение
        КонецПопытки;
        
        Если ПустаяСтрока(Данные.Должность) Тогда
            Данные.Должность = ?(ИсточникДокумент.Должность = Неопределено, "", ИсточникДокумент.Должность.Наименование);
        КонецЕсли;
        
        Если ПустаяСтрока(Данные.Подразделение) Тогда
            Данные.Подразделение = ?(ИсточникДокумент.Подразделение = Неопределено, "", ИсточникДокумент.Подразделение.Наименование);
        КонецЕсли;
    КонецЕсли;
    
    // === 3. ПОЛУЧАЕМ КОНТАКТНУЮ ИНФОРМАЦИЮ через БСП ===
    Попытка
        // Получаем ссылку на физическое лицо
        ОбъектСотрудника = СсылкаНаСотрудника.ПолучитьОбъект();
        Если ОбъектСотрудника <> Неопределено И ОбъектСотрудника.ФизическоеЛицо <> Неопределено Тогда
            ФизЛицо = ОбъектСотрудника.ФизическоеЛицо;
            
            // Получаем ВСЕ контактные данные через БСП
            ТелефонФизЛица = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ФизЛицо, Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица, ТекущаяДатаСеанса(), Истина);
			Данные.Телефон = ТелефонФизЛица;
            
			//// Перебираем и извлекаем телефон и email
			//Для Каждого Контакт Из ТЗКонтакты Цикл
			//    Если Контакт.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			//        Если ПустаяСтрока(Данные.Телефон) Тогда
			//            Данные.Телефон = Контакт.Представление;
			//        КонецЕсли;
			//    ИначеЕсли Контакт.Тип = Перечисления.ТипыКонтактнойИнформации.ЭлектроннаяПочта Тогда
			//        Если ПустаяСтрока(Данные.Email) Тогда
			//            Данные.Email = Контакт.Представление;
			//        КонецЕсли;
			//    КонецЕсли;
			//КонецЦикла;
        КонецЕсли;
        
    Исключение
        // Если БСП не сработала — оставляем пустыми
    КонецПопытки;
    
    // === 4. Проверяем, что хоть что-то получили ===
    Если ПустаяСтрока(Данные.ФИО) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Возврат Данные;
    
КонецФункции