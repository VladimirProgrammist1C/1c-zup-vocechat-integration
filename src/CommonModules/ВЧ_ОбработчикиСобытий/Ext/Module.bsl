#Область ОбработкаОчереди

// Описание:
// Обрабатывает очередь уведомлений, ожидающих отправки.
// Выбирает задачи со статусом "Ожидает" и отправляет их в VoceChat.
//
&НаСервере
Процедура Обработать() Экспорт
    
    // Читаем лимит из константы (с защитой от пустого значения)
    МаксПопыток = Константы.ВЧ_МаксимальноеКоличествоПопыток.Получить();
    Если МаксПопыток < 1 Тогда
        МаксПопыток = 1; // Минимальная защита, чтобы цикл вообще работал
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = "
        |ВЫБРАТЬ
        |   Очередь.ИДСообщения КАК ИДСообщения,
        |   Очередь.Период,      
		|   Очередь.ДокументОснование,
        |   Очередь.ТекстСообщения,
        |   Очередь.IDКанала,
        |   Очередь.ПопыткиОтправки
        |ИЗ
        |   РегистрСведений.ВЧ_ОчередьУведомлений.СрезПоследних(&ТекущаяДата, Статус = &СтатусОжидает) КАК Очередь
        |ГДЕ
        |   Очередь.ПопыткиОтправки < &МаксПопыток
        |УПОРЯДОЧИТЬ ПО
        |   Очередь.Период ВОЗР";
    
    Запрос.УстановитьПараметр("СтатусОжидает", Перечисления.ВЧ_СтатусыУведомлений.Ожидает);
    Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
    Запрос.УстановитьПараметр("МаксПопыток", МаксПопыток); // <--- Подставляем значение константы
    
    Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
	    Попытка
	        // Текст уже готов в регистре — просто читаем!
			//ТекстСообщения = Выборка.ТекстСообщения;
			ТекстСообщения = Выборка.ТекстСообщения.Получить();
	        
	        // Отправляем уведомление
	        Результат = ВЧ_ИнтеграцияСервер.ОтправитьУведомление(
	            Выборка.IDКанала,
	            ТекстСообщения
	        );
	        
	        // Обновляем статус
	        ОбновитьСтатусЗадачи(
	            Выборка.ИДСообщения,
	            Выборка.Период,
	            Результат
	        );
	        
	    Исключение
	        ЗаписьЖурналаРегистрации(
	            "ВЧ_Интеграция",
	            УровеньЖурналаРегистрации.Ошибка,
	            ,
	            Выборка.ДокументОснование,
	            ОписаниеОшибки()
	        );
	    КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеСообщения

// Описание:
// Формирует текст уведомления в формате Markdown для отправки в VoceChat.
//
// Параметры:
//  Данные - Структура с данными сотрудника (ФИО, Должность, Подразделение, Телефон)
//  ФИОКадровика - ФИО ответственного кадровика
//
// Возвращаемое значение:
//  Строка - Текст сообщения в формате Markdown
//
&НаСервере
Функция СформироватьТекстУведомления(Знач Данные, Знач ФИОКадровика)
	
	ТекстШаблона = 
		" *Новая задача!*
		|═══════════════════════
		|Принят новый сотрудник.
		|
		| *ФИО:* %1
		| *Должность:* %2
		| *Подразделение:* %3
		| *Контакт с новым сотрудником (тел.):* %4
		|
		|═══════════════════════
		| *Задача:* Необходимо создать корпоративную электронную почту.
		|
		| *Ответственный кадровик:* %5
		|⏰ *Дата время:* %6
		|═══════════════════════
		|_Уведомление из 1С:ЗУП 3.1_";
	
	Возврат СтрШаблон(
		ТекстШаблона,
		ПолучитьЗначениеИлиПоУмолчанию(Данные.ФИО, "Не определено"),
		ПолучитьЗначениеИлиПоУмолчанию(Данные.Должность, "Не указана"),
		ПолучитьЗначениеИлиПоУмолчанию(Данные.Подразделение, "Не указано"),
		ПолучитьЗначениеИлиПоУмолчанию(Данные.Телефон, "Не указан"),
		ПолучитьЗначениеИлиПоУмолчанию(ФИОКадровика, "Не определён"),
		Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'")
	);
	
КонецФункции

// Описание:
// Возвращает значение или значение по умолчанию, если исходное значение пустое.
//
// Параметры:
//  Значение - Проверяемое значение
//  ЗначениеПоУмолчанию - Значение, возвращаемое если исходное пустое
//
// Возвращаемое значение:
//  Исходное значение или значение по умолчанию
//
&НаСервере
Функция ПолучитьЗначениеИлиПоУмолчанию(Знач Значение, Знач ЗначениеПоУмолчанию)
	
	Если ПустаяСтрока(Значение) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Описание:
// Обработчик события ПередЗаписью документа "Прием на работу".
// Создает задачу в очереди на отправку уведомления в VoceChat.
//
// Параметры:
//  Источник - Объект документа "Прием на работу"
//  Отказ - Признак отмены записи
//  РежимЗаписи - Режим записи документа
//  РежимПроведения - Режим проведения документа
//
&НаСервере
Процедура ВЧ_ПриПриемеНаРаботуПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
    
	// Проверка: только ПЕРВОЕ проведение
	Если Не ЭтоПервоеПроведение(РежимЗаписи, Источник.Проведен) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем интеграцию
	Если Не Константы.ВЧ_ИспользоватьИнтеграцию.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем ссылку на сотрудника
	СсылкаНаСотрудника = Источник.Сотрудник;
	Если СсылкаНаСотрудника = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем данные через функцию (БСП)
	ДанныеСотрудника = ПолучитьДанныеСотрудника(СсылкаНаСотрудника, Источник);
	
	Если ДанныеСотрудника = Неопределено Тогда
		ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
			"Не удалось получить данные сотрудника");
		Возврат;
	КонецЕсли;
	
	// Получаем ответственного (автора документа)
	ДанныеСотрудника.Вставить("ФИОКадровика", ПолучитьФИООтветственного(Источник.Ответственный));
	
	// Записываем в очередь
	Попытка
		//ДобавитьВОчередьУведомлений(СсылкаНаСотрудника, ДанныеСотрудника);                                  
		// Формируем текст сообщения
		ТекстСообщения = СформироватьТекстУведомления(ДанныеСотрудника, ДанныеСотрудника.ФИОКадровика);

		// Получаем ID канала из константы
		IDКанала = Константы.ВЧ_IDКанала.Получить();

		// Добавляем в очередь с новыми параметрами
		ДобавитьВОчередьУведомлений(
		    Источник.Ссылка,                 // ДокументОснование
		    ТекстСообщения,                  // ТекстСообщения
		    IDКанала,                        // IDКанала
		    ДанныеСотрудника.ФИОКадровика    // ОтветственныйКадровик
		);
		ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Информация, , СсылкаНаСотрудника, 
			"Задача поставлена в очередь. Сотрудник: " + ДанныеСотрудника.ФИО);
	Исключение
		ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка записи в регистр: " + ОписаниеОшибки());
	КонецПопытки;
    
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание:
// Проверяет, что это первое проведение документа.
//
// Параметры:
//  РежимЗаписи - Режим записи документа
//  ДокументПроведен - Признак проведения документа
//
// Возвращаемое значение:
//  Булево - Истина, если это первое проведение
//
&НаСервере
Функция ЭтоПервоеПроведение(Знач РежимЗаписи, Знач ДокументПроведен)
	
	Возврат РежимЗаписи = РежимЗаписиДокумента.Проведение И Не ДокументПроведен;
	
КонецФункции

// Описание:
// Получает ФИО ответственного из ссылки пользователя.
//
// Параметры:
//  Ответственный - Ссылка на пользователя (Пользователи)
//
// Возвращаемое значение:
//  Строка - ФИО пользователя или "Не определён"
//
&НаСервере
Функция ПолучитьФИООтветственного(Знач Ответственный)
	
	Если Ответственный = Неопределено Тогда
		Возврат "Не определён";
	КонецЕсли;
	
	Попытка
		Возврат Ответственный.Наименование;
	Исключение
		Возврат "Неизвестный";
	КонецПопытки;
	
КонецФункции

