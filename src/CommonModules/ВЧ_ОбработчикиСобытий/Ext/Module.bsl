&НаСервере
Процедура Обработать() Экспорт
	
	// 1. Выбираем задачи, которые ждут обработки > 5 секунд (защита от транзакционных блокировок)
	Запрос = Новый Запрос;
	Запрос.Текст = "
		|	ВЫБРАТЬ
		|		Очередь.Сотрудник КАК ЗаписьОчереди,
		|		Очередь.Сотрудник,
		|		Очередь.Параметры
		|	ИЗ
		|		РегистрСведений.ВЧ_ОчередьУведомлений КАК Очередь
		|	ГДЕ
		|		Очередь.Статус = &СтатусОжидает
		|		И Очередь.ДатаСоздания < &ВремяОбработки";
	Запрос.УстановитьПараметр("СтатусОжидает", Перечисления.ВЧ_СтатусыУведомлений.Ожидает);
	Запрос.УстановитьПараметр("ВремяОбработки", ТекущаяДатаСеанса() - 5);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Попытка
			
			// 2. Получаем параметры задачи
			Параметры = Выборка.Параметры.Получить();
			ФИОКадровика = Параметры.ФИОКадровика;
			
			// 3. Данные уже есть в Выборке (мы передали их в подписке)
			Данные = Выборка.Сотрудник; 
			// В твоём случае, так как мы записали всё в Параметры в подписке,
			// можно брать ФИО/Должность/Телефон прямо из Выборка.Параметры!
			// Это еще быстрее, чем делать запрос к справочнику здесь.
			
			// 4. Отправляем в VoceChat (данные берем из параметров записи)
			// В параметрах у нас Структура: ФИО, Должность, Подразделение, Телефон
			ДанныеИзПараметров = Выборка.Параметры.Получить();
			
			ТекстСообщения = СформироватьТекстУведомления(ДанныеИзПараметров, ФИОКадровика);
			//ТекстСообщения = СформироватьТекстУведомления(ДанныеИзПараметров, "");
			
			Результат = ВЧ_ИнтеграцияСервер.ОтправитьУведомление(Выборка.Сотрудник, ТекстСообщения);
			
			// 5. Обновляем статус через НаборЗаписей (так как Ссылки нет)
			НаборЗаписей = РегистрыСведений.ВЧ_ОчередьУведомлений.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Сотрудник.Установить(Выборка.Сотрудник);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() > 0 Тогда
				Запись = НаборЗаписей[0];
				Если Результат.Успех Тогда
					Запись.Статус = Перечисления.ВЧ_СтатусыУведомлений.Отправлено;
				Иначе
					Запись.Статус = Перечисления.ВЧ_СтатусыУведомлений.Ошибка;
				КонецЕсли;
				НаборЗаписей.Записать();
			КонецЕсли;
			
		Исключение
			//// Фиксируем критическую ошибку, чтобы задача не крутилась вечно
			//ОбъектОчереди = Выборка.ЗаписьОчереди.ПолучитьОбъект();
			//ОбъектОчереди.Статус = Перечисления.ВЧ_СтатусыУведомлений.Ошибка;
			//ОбъектОчереди.Записать();
			ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , Выборка.Сотрудник, ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

