//###############################################################################
// Обработчики событий для интеграции с VoceChat
//###############################################################################

#Область ОбработкаОчереди

&НаСервере
Процедура Обработать() Экспорт
    
    МаксПопыток = Константы.ВЧ_МаксимальноеКоличествоПопыток.Получить();
    Если МаксПопыток < 1 Тогда
        МаксПопыток = 1;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = "
        |ВЫБРАТЬ
        |   Очередь.ИДСообщения КАК ИДСообщения,
        |   Очередь.Период,      
        |   Очередь.ДокументОснование,
        |   Очередь.ТекстСообщения,
        |   Очередь.IDКанала,
        |   Очередь.ПопыткиОтправки
        |ИЗ
        |   РегистрСведений.ВЧ_ОчередьУведомлений.СрезПоследних(&ТекущаяДата, Статус = &СтатусОжидает) КАК Очередь
        |ГДЕ
        |   Очередь.ПопыткиОтправки < &МаксПопыток
        |УПОРЯДОЧИТЬ ПО
        |   Очередь.Период ВОЗР";
    
    Запрос.УстановитьПараметр("СтатусОжидает", Перечисления.ВЧ_СтатусыУведомлений.Ожидает);
    Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
    Запрос.УстановитьПараметр("МаксПопыток", МаксПопыток);
    
    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл
        Попытка
            ТекстСообщения = Выборка.ТекстСообщения.Получить();
            
            Результат = ВЧ_ИнтеграцияСервер.ОтправитьУведомление(
                Выборка.IDКанала,
                ТекстСообщения
            );
            
            ОбновитьСтатусЗадачи(
                Выборка.ИДСообщения,
                Выборка.Период,
                Результат
            );
            
        Исключение
            ЗаписьЖурналаРегистрации(
                "ВЧ_Интеграция",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                Выборка.ДокументОснование,
                ОписаниеОшибки()
            );
        КонецПопытки;
    КонецЦикла;
    
КонецПроцедуры

#КонецОбласти

#Область ФормированиеСообщения

&НаСервере
Функция СформироватьТекстУведомления(Знач Данные, Знач ФИОКадровика)
    
    ТекстШаблона = 
        " *Новая задача!*
        |═══════════════════════
        |Принят новый сотрудник.
        |
        | *ФИО:* %1
        | *Должность:* %2
        | *Подразделение:* %3
        | *Контакт с новым сотрудником (тел.):* %4
        |
        |═══════════════════════
        | *Задача:* Необходимо создать корпоративную электронную почту.
        |
        | *Ответственный кадровик:* %5
        |⏰ *Дата время:* %6
        |═══════════════════════
        |_Уведомление из 1С:ЗУП 3.1_";
    
    Возврат СтрШаблон(
        ТекстШаблона,
        ПолучитьЗначениеИлиПоУмолчанию(Данные.ФИО, "Не определено"),
        ПолучитьЗначениеИлиПоУмолчанию(Данные.Должность, "Не указана"),
        ПолучитьЗначениеИлиПоУмолчанию(Данные.Подразделение, "Не указано"),
        ПолучитьЗначениеИлиПоУмолчанию(Данные.Телефон, "Не указан"),
        ПолучитьЗначениеИлиПоУмолчанию(ФИОКадровика, "Не определён"),
        Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'")
    );
    
КонецФункции

&НаСервере
Функция ПолучитьЗначениеИлиПоУмолчанию(Знач Значение, Знач ЗначениеПоУмолчанию)
    Если ПустаяСтрока(Значение) Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;
    Возврат Значение;
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

&НаСервере
Процедура ВЧ_ПриПриемеНаРаботуПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
    
    Если Не ЭтоПервоеПроведение(РежимЗаписи, Источник.Проведен) Тогда
        Возврат;
    КонецЕсли;
    
    Если Не Константы.ВЧ_ИспользоватьИнтеграцию.Получить() Тогда
        Возврат;
    КонецЕсли;
    
    СсылкаНаСотрудника = Источник.Сотрудник;
    Если СсылкаНаСотрудника = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ДанныеСотрудника = ПолучитьДанныеСотрудника(СсылкаНаСотрудника, Источник);
    
    Если ДанныеСотрудника = Неопределено Тогда
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
            "Не удалось получить данные сотрудника");
        Возврат;
    КонецЕсли;
    
    ДанныеСотрудника.Вставить("ФИОКадровика", ПолучитьФИООтветственного(Источник.Ответственный));
    
    Попытка
        ТекстСообщения = СформироватьТекстУведомления(ДанныеСотрудника, ДанныеСотрудника.ФИОКадровика);
        IDКанала = Константы.ВЧ_IDКанала.Получить();

        ДобавитьВОчередьУведомлений(
            Источник.Ссылка,                 
            ТекстСообщения,                  
            IDКанала,                        
            ДанныеСотрудника.ФИОКадровика    
        );
        
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Информация, , СсылкаНаСотрудника, 
            "Задача поставлена в очередь. Сотрудник: " + ДанныеСотрудника.ФИО);
    Исключение
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
            "Ошибка записи в регистр: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЭтоПервоеПроведение(Знач РежимЗаписи, Знач ДокументПроведен)
    Возврат РежимЗаписи = РежимЗаписиДокумента.Проведение И Не ДокументПроведен;
КонецФункции

&НаСервере
Функция ПолучитьФИООтветственного(Знач Ответственный)
    Если Ответственный = Неопределено Тогда
        Возврат "Не определён";
    КонецЕсли;
    Попытка
        Возврат Ответственный.Наименование;
    Исключение
        Возврат "Неизвестный";
    КонецПопытки;
КонецФункции

&НаСервере
Процедура ДобавитьВОчередьУведомлений(
    Знач ДокументОснование,
    Знач ТекстСообщения,
    Знач IDКанала,
    Знач ОтветственныйКадровик
)
    
    ИДСообщения = Строка(Новый УникальныйИдентификатор());
    ТекущийПериод = ТекущаяДатаСеанса();
    
    ЗаписьЖурналаРегистрации("ВЧ_Интеграция", 
        УровеньЖурналаРегистрации.Информация, , , 
        "Добавление в очередь: Документ=" + ТипЗнч(ДокументОснование) + 
        ", ТекстДлиной=" + СтрДлина(ТекстСообщения));
    
    НаборЗаписей = РегистрыСведений.ВЧ_ОчередьУведомлений.СоздатьНаборЗаписей();
    Запись = НаборЗаписей.Добавить();
    
    // === ЗАПОЛНЯЕМ ИЗМЕРЕНИЯ ===
    Запись.Период = ТекущийПериод;
    Запись.ИДСообщения = ИДСообщения;
    // IDКанала перенесен в Ресурсы, поэтому здесь не заполняем как измерение!
    
    // === ЗАПОЛНЯЕМ РЕСУРСЫ ===
    Запись.Статус = Перечисления.ВЧ_СтатусыУведомлений.Ожидает;
    Запись.ТекстСообщения = Новый ХранилищеЗначения(ТекстСообщения);
    Запись.ПопыткиОтправки = 0;
    Запись.ТипСобытия = "НовыйСотрудник"; 
    Запись.ТекстОшибки = "";
    Запись.ДатаСоздания = ТекущийПериод;
    Запись.ДатаПоследнейПопытки = Дата('00010101');
    Запись.ОтветственныйКадровик = ОтветственныйКадровик;
    Запись.ДокументОснование = ДокументОснование;
    Запись.IDКанала = IDКанала; // Заполняем ресурс
    
    // === КРИТИЧЕСКИ ВАЖНО: Установка отборов перед записью ===
    НаборЗаписей.Отбор.Период.Установить(ТекущийПериод);
    НаборЗаписей.Отбор.ИДСообщения.Установить(ИДСообщения);
    
    НаборЗаписей.Записать();
    
    ЗаписьЖурналаРегистрации("ВЧ_Интеграция", 
        УровеньЖурналаРегистрации.Информация, , , 
        "Запись в регистр выполнена. ИДСообщения=" + ИДСообщения);
    
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусЗадачи(Знач ИДСообщения, Знач Период, Знач Результат)
    
    НаборЗаписей = РегистрыСведений.ВЧ_ОчередьУведомлений.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.ИДСообщения.Установить(ИДСообщения);
    НаборЗаписей.Прочитать();
    
    Если НаборЗаписей.Количество() > 0 Тогда
        Запись = НаборЗаписей[0];
        
        Запись.ПопыткиОтправки = Запись.ПопыткиОтправки + 1;
        Запись.ДатаПоследнейПопытки = ТекущаяДатаСеанса();
        
        Если Результат.Успех Тогда
            Запись.Статус = Перечисления.ВЧ_СтатусыУведомлений.Отправлено;
            Запись.ТекстОшибки = "";
            ЗаписьЖурналаРегистрации("ВЧ_Интеграция", 
                УровеньЖурналаРегистрации.Информация, , , 
                "✅ Статус обновлён на ОТПРАВЛЕНО. Попыток: " + Запись.ПопыткиОтправки);
        Иначе
            Запись.Статус = Перечисления.ВЧ_СтатусыУведомлений.Ошибка;
            Запись.ТекстОшибки = Результат.Детали;
            ЗаписьЖурналаРегистрации("ВЧ_Интеграция", 
                УровеньЖурналаРегистрации.Предупреждение, , , 
                "⚠️ Статус обновлён на ОШИБКА. Попыток: " + Запись.ПопыткиОтправки);
        КонецЕсли;
        
        НаборЗаписей.Записать();
    Иначе
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", 
            УровеньЖурналаРегистрации.Ошибка, , , 
            "❌ ЗАПИСЬ НЕ НАЙДЕНА по ИДСообщения=" + ИДСообщения);
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеСотрудника(СсылкаНаСотрудника, ИсточникДокумент = Неопределено)
    
    Данные = СоздатьПустуюСтруктуруДанных();
    ЗаполнитьКадровыеДанные(Данные, СсылкаНаСотрудника, ИсточникДокумент);
    
    Если ПустаяСтрока(Данные.ФИО) Тогда
        ЗаполнитьДанныеИзДокумента(Данные, СсылкаНаСотрудника, ИсточникДокумент);
    КонецЕсли;
    
    ЗаполнитьКонтактнуюИнформацию(Данные, СсылкаНаСотрудника);
    
    Если ПустаяСтрока(Данные.ФИО) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Возврат Данные;
    
КонецФункции

&НаСервере
Функция СоздатьПустуюСтруктуруДанных()
    Данные = Новый Структура;
    Данные.Вставить("ФИО", "");
    Данные.Вставить("Должность", "");
    Данные.Вставить("Подразделение", "");
    Данные.Вставить("Телефон", "");
    Данные.Вставить("Email", "");
    Данные.Вставить("ФИОКадровика", "");
    Возврат Данные;
КонецФункции

&НаСервере
Процедура ЗаполнитьКадровыеДанные(Данные, СсылкаНаСотрудника, ИсточникДокумент)
    Попытка
        ТЗКадровые = КадровыйУчет.КадровыеДанныеСотрудников(
            Истина,
            СсылкаНаСотрудника,
            "ФИОПолные, Должность, Подразделение",
            ТекущаяДатаСеанса()
        );
        
        Если ТЗКадровые.Количество() > 0 Тогда
            СтрокаДанных = ТЗКадровые[0];
            Данные.ФИО = СтрокаДанных.ФИОПолные;
            
            Если ИсточникДокумент <> Неопределено Тогда
                Данные.Должность = ПолучитьНаименованиеИлиПусто(ИсточникДокумент.Должность);
                Данные.Подразделение = ПолучитьНаименованиеИлиПусто(ИсточникДокумент.Подразделение);
            КонецЕсли;
        КонецЕсли;
    Исключение
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеИзДокумента(Данные, СсылкаНаСотрудника, ИсточникДокумент)
    Попытка
        ОбъектСотрудника = СсылкаНаСотрудника.ПолучитьОбъект();
        Если ОбъектСотрудника <> Неопределено Тогда
            Данные.ФИО = ОбъектСотрудника.ФизическоеЛицо.Наименование;
        КонецЕсли;
    Исключение
    КонецПопытки;
    
    Если ИсточникДокумент <> Неопределено Тогда
        Данные.Должность = ПолучитьНаименованиеИлиПусто(ИсточникДокумент.Должность);
        Данные.Подразделение = ПолучитьНаименованиеИлиПусто(ИсточникДокумент.Подразделение);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтактнуюИнформацию(Данные, СсылкаНаСотрудника)
    Попытка
        ОбъектСотрудника = СсылкаНаСотрудника.ПолучитьОбъект();
        Если ОбъектСотрудника <> Неопределено И ОбъектСотрудника.ФизическоеЛицо <> Неопределено Тогда
            ФизЛицо = ОбъектСотрудника.ФизическоеЛицо;
            Данные.Телефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
                ФизЛицо, 
                Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица, 
                ТекущаяДатаСеанса(), 
                Истина);
        КонецЕсли;
    Исключение
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПолучитьНаименованиеИлиПусто(Знач Ссылка)
    Если Ссылка = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Попытка
        Возврат Ссылка.Наименование;
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

#КонецОбласти