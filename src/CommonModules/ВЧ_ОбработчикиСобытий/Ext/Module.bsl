&НаСервере
Процедура ОбновитьСтатусЗадачи(Знач ИДСообщения, Знач Период, Знач Результат)
    
    // Фильтруем только по уникальному ID. Период игнорируем, чтобы избежать проблем с UTC/LocalTime
    НаборЗаписей = РегистрыСведений.ВЧ_ОчередьУведомлений.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.ИДСообщения.Установить(ИДСообщения);
    НаборЗаписей.Прочитать();
    
    Если НаборЗаписей.Количество() > 0 Тогда
        Запись = НаборЗаписей[0];
        
        // Увеличиваем счётчик попыток
        Запись.ПопыткиОтправки = Запись.ПопыткиОтправки + 1;
        Запись.ДатаПоследнейПопытки = ТекущаяДатаСеанса();
        
        Если Результат.Успех Тогда
            Запись.Статус = Перечисления.ВЧ_СтатусыУведомлений.Отправлено;
            Запись.ТекстОшибки = "";
            ЗаписьЖурналаРегистрации("ВЧ_Интеграция", 
                УровеньЖурналаРегистрации.Информация, , , 
                "✅ Статус обновлён на ОТПРАВЛЕНО. Попыток: " + Запись.ПопыткиОтправки);
        Иначе
            Запись.Статус = Перечисления.ВЧ_СтатусыУведомлений.Ошибка;
            Запись.ТекстОшибки = Результат.Детали;
            ЗаписьЖурналаРегистрации("ВЧ_Интеграция", 
                УровеньЖурналаРегистрации.Предупреждение, , , 
                "⚠️ Статус обновлён на ОШИБКА. Попыток: " + Запись.ПопыткиОтправки);
        КонецЕсли;
        
        // Сохраняем изменения
        НаборЗаписей.Записать();
    Иначе
        ЗаписьЖурналаРегистрации("ВЧ_Интеграция", 
            УровеньЖурналаРегистрации.Ошибка, , , 
            "❌ ЗАПИСЬ НЕ НАЙДЕНА по ИДСообщения=" + ИДСообщения);
    КонецЕсли;
    
КонецПроцедуры

// Описание:
// Получает данные сотрудника для формирования уведомления.
// Использует БСП для получения кадровых данных и контактной информации.
//
// Параметры:
//  СсылкаНаСотрудника - Ссылка на сотрудника
//  ИсточникДокумент - Документ-источник "Прием на работу" (необязательно)
//
// Возвращаемое значение:
//  Структура - Данные сотрудника (ФИО, Должность, Подразделение, Телефон, Email, ФИОКадровика)
//
&НаСервере
Функция ПолучитьДанныеСотрудника(СсылкаНаСотрудника, ИсточникДокумент = Неопределено)
	
	Данные = СоздатьПустуюСтруктуруДанных();
	
	ЗаполнитьКадровыеДанные(Данные, СсылкаНаСотрудника, ИсточникДокумент);
	
	Если ПустаяСтрока(Данные.ФИО) Тогда
		ЗаполнитьДанныеИзДокумента(Данные, СсылкаНаСотрудника, ИсточникДокумент);
	КонецЕсли;
	
	ЗаполнитьКонтактнуюИнформацию(Данные, СсылкаНаСотрудника);
	
	Если ПустаяСтрока(Данные.ФИО) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

// Описание:
// Создает пустую структуру данных сотрудника.
//
// Возвращаемое значение:
//  Структура - Пустая структура данных сотрудника
//
&НаСервере
Функция СоздатьПустуюСтруктуруДанных()
	
	Данные = Новый Структура;
	Данные.Вставить("ФИО", "");
	Данные.Вставить("Должность", "");
	Данные.Вставить("Подразделение", "");
	Данные.Вставить("Телефон", "");
	Данные.Вставить("Email", "");
	Данные.Вставить("ФИОКадровика", "");
	
	Возврат Данные;
	
КонецФункции

// Описание:
// Заполняет кадровые данные сотрудника через БСП.
//
// Параметры:
//  Данные - Структура для заполнения (изменяется)
//  СсылкаНаСотрудника - Ссылка на сотрудника
//  ИсточникДокумент - Документ-источник для получения должности и подразделения
//
&НаСервере
Процедура ЗаполнитьКадровыеДанные(Данные, СсылкаНаСотрудника, ИсточникДокумент)
	
	Попытка
		ТЗКадровые = КадровыйУчет.КадровыеДанныеСотрудников(
			Истина,
			СсылкаНаСотрудника,
			"ФИОПолные, Должность, Подразделение",
			ТекущаяДатаСеанса()
		);
		
		Если ТЗКадровые.Количество() > 0 Тогда
			СтрокаДанных = ТЗКадровые[0];
			Данные.ФИО = СтрокаДанных.ФИОПолные;
			
			Если ИсточникДокумент <> Неопределено Тогда
				Данные.Должность = ПолучитьНаименованиеИлиПусто(ИсточникДокумент.Должность);
				Данные.Подразделение = ПолучитьНаименованиеИлиПусто(ИсточникДокумент.Подразделение);
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Описание:
// Заполняет данные из объекта сотрудника (fallback вариант).
//
// Параметры:
//  Данные - Структура для заполнения (изменяется)
//  СсылкаНаСотрудника - Ссылка на сотрудника
//  ИсточникДокумент - Документ-источник для получения должности и подразделения
//
&НаСервере
Процедура ЗаполнитьДанныеИзДокумента(Данные, СсылкаНаСотрудника, ИсточникДокумент)
	
	Попытка
		ОбъектСотрудника = СсылкаНаСотрудника.ПолучитьОбъект();
		Если ОбъектСотрудника <> Неопределено Тогда
			Данные.ФИО = ОбъектСотрудника.ФизическоеЛицо.Наименование;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Если ИсточникДокумент <> Неопределено Тогда
		Данные.Должность = ПолучитьНаименованиеИлиПусто(ИсточникДокумент.Должность);
		Данные.Подразделение = ПолучитьНаименованиеИлиПусто(ИсточникДокумент.Подразделение);
	КонецЕсли;
	
КонецПроцедуры

// Описание:
// Заполняет контактную информацию сотрудника через БСП.
//
// Параметры:
//  Данные - Структура для заполнения (изменяется)
//  СсылкаНаСотрудника - Ссылка на сотрудника
//
&НаСервере
Процедура ЗаполнитьКонтактнуюИнформацию(Данные, СсылкаНаСотрудника)
	
	Попытка
		ОбъектСотрудника = СсылкаНаСотрудника.ПолучитьОбъект();
		Если ОбъектСотрудника <> Неопределено И ОбъектСотрудника.ФизическоеЛицо <> Неопределено Тогда
			ФизЛицо = ОбъектСотрудника.ФизическоеЛицо;
			Данные.Телефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				ФизЛицо, 
				Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица, 
				ТекущаяДатаСеанса(), 
				Истина);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Описание:
// Возвращает наименование справочника или пустую строку.
//
// Параметры:
//  Ссылка - Ссылка на элемент справочника
//
// Возвращаемое значение:
//  Строка - Наименование или пустая строка
//
&НаСервере
Функция ПолучитьНаименованиеИлиПусто(Знач Ссылка)
	
	Если Ссылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат Ссылка.Наименование;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

#КонецОбласти